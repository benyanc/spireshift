{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/production-policy-evaluation-v5.json",
  "title": "SpireShift Fresh Development Combat Policy Comparison v5",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "started_at",
    "completed_at",
    "model_id",
    "training_report_id",
    "reference_model_id",
    "reference_training_report_id",
    "split_manifest_id",
    "partition",
    "ruleset_manifest_id",
    "patch_id",
    "objective_id",
    "configuration",
    "cases",
    "summary",
    "claim_scope",
    "confirmation_config",
    "objective",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "production-policy-evaluation-v5"
    },
    "report_id": {
      "$ref": "#/$defs/identifier"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "model_id": {
      "$ref": "#/$defs/identifier"
    },
    "training_report_id": {
      "$ref": "#/$defs/identifier"
    },
    "reference_model_id": {
      "$ref": "#/$defs/identifier"
    },
    "reference_training_report_id": {
      "$ref": "#/$defs/identifier"
    },
    "split_manifest_id": {
      "$ref": "#/$defs/identifier"
    },
    "partition": {
      "const": "train"
    },
    "ruleset_manifest_id": {
      "$ref": "#/$defs/identifier"
    },
    "patch_id": {
      "type": "string",
      "minLength": 1
    },
    "objective_id": {
      "const": "terminal-victory-v1"
    },
    "configuration": {
      "type": "object",
      "required": [
        "seeds",
        "workers",
        "maximum_decisions_per_run",
        "cycle_repetition_threshold",
        "liveness_tail_length",
        "no_op_fallback_controller_id",
        "no_op_fallback_threshold",
        "paired_policies"
      ],
      "properties": {
        "seeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "workers": {
          "const": 1
        },
        "maximum_decisions_per_run": {
          "type": "integer",
          "minimum": 1
        },
        "cycle_repetition_threshold": {
          "type": "integer",
          "minimum": 2
        },
        "liveness_tail_length": {
          "type": "integer",
          "minimum": 1
        },
        "no_op_fallback_controller_id": {
          "const": "public-no-op-action-guard-v1"
        },
        "no_op_fallback_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "paired_policies": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "seed",
          "policy_kind",
          "path",
          "case_id"
        ],
        "properties": {
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "policy_kind": {
            "enum": [
              "production_checkpoint",
              "reference_production_checkpoint"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "case_id": {
            "$ref": "#/$defs/identifier"
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "candidate",
        "reference",
        "paired"
      ],
      "properties": {
        "candidate": {
          "$ref": "#/$defs/policySummary"
        },
        "reference": {
          "$ref": "#/$defs/policySummary"
        },
        "paired": {
          "$ref": "#/$defs/pairedSummary"
        }
      },
      "additionalProperties": false
    },
    "claim_scope": {
      "enum": [
        "paired_fresh_train_development_policy_only_confirmation",
        "paired_inspected_train_neural_selection_compatibility"
      ]
    },
    "confirmation_config": {
      "oneOf": [
        {
          "$ref": "https://spireshift.dev/schemas/combat-policy-confirmation-config-v1.json"
        },
        {
          "$ref": "https://spireshift.dev/schemas/combat-policy-confirmation-config-v2.json"
        }
      ]
    },
    "objective": {
      "$ref": "https://spireshift.dev/schemas/combat-foundation-audit-config-v1.json#/properties/objective"
    },
    "decision": {
      "type": "object",
      "required": [
        "checkpoint_promoted",
        "foundation_ready",
        "adaptive_controller_allowed",
        "next_step"
      ],
      "properties": {
        "checkpoint_promoted": {
          "const": false
        },
        "foundation_ready": {
          "const": false
        },
        "adaptive_controller_allowed": {
          "const": false
        },
        "next_step": {
          "const": "owner_result_review_before_any_follow_up"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "policySummary": {
      "type": "object",
      "required": [
        "benchmark_denominator",
        "completed_runs",
        "failed_runs",
        "terminal_runs",
        "truncated_runs",
        "victories",
        "victory_rate",
        "completion_rate",
        "terminal_rate",
        "mean_maximum_floor",
        "decisions",
        "total_decision_seconds",
        "mean_seconds_per_decision",
        "nondegenerate_terminal_outcomes",
        "policy_cycle_runs",
        "decision_limit_runs",
        "liveness_pass",
        "fallback_runs",
        "fallback_invocations",
        "suppressed_no_op_actions",
        "fallback_exhausted_states",
        "victory_rate_interval_95",
        "interval_method",
        "cpu_budget_runs",
        "unsupported_public_combat_runs",
        "act1_boss_reaches",
        "act1_clears",
        "total_run_cpu_seconds",
        "total_initialization_cpu_seconds",
        "total_run_wall_seconds",
        "attempted_decisions",
        "completed_transitions",
        "maximum_case_p95_inference_seconds"
      ],
      "properties": {
        "benchmark_denominator": {
          "type": "integer",
          "minimum": 1
        },
        "completed_runs": {
          "type": "integer",
          "minimum": 0
        },
        "failed_runs": {
          "type": "integer",
          "minimum": 0
        },
        "terminal_runs": {
          "type": "integer",
          "minimum": 0
        },
        "truncated_runs": {
          "type": "integer",
          "minimum": 0
        },
        "victories": {
          "type": "integer",
          "minimum": 0
        },
        "victory_rate": {
          "$ref": "#/$defs/rate"
        },
        "completion_rate": {
          "$ref": "#/$defs/rate"
        },
        "terminal_rate": {
          "$ref": "#/$defs/rate"
        },
        "mean_maximum_floor": {
          "type": "number",
          "minimum": 0
        },
        "decisions": {
          "type": "integer",
          "minimum": 0
        },
        "total_decision_seconds": {
          "type": "number",
          "minimum": 0
        },
        "mean_seconds_per_decision": {
          "type": "number",
          "minimum": 0
        },
        "nondegenerate_terminal_outcomes": {
          "type": "boolean"
        },
        "policy_cycle_runs": {
          "type": "integer",
          "minimum": 0
        },
        "decision_limit_runs": {
          "type": "integer",
          "minimum": 0
        },
        "liveness_pass": {
          "type": "boolean"
        },
        "fallback_runs": {
          "type": "integer",
          "minimum": 0
        },
        "fallback_invocations": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed_no_op_actions": {
          "type": "integer",
          "minimum": 0
        },
        "fallback_exhausted_states": {
          "type": "integer",
          "minimum": 0
        },
        "victory_rate_interval_95": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "interval_method": {
          "const": "wilson_score_approximate_seed_sampling"
        },
        "cpu_budget_runs": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported_public_combat_runs": {
          "type": "integer",
          "minimum": 0
        },
        "act1_boss_reaches": {
          "type": "integer",
          "minimum": 0
        },
        "act1_clears": {
          "type": "integer",
          "minimum": 0
        },
        "total_run_cpu_seconds": {
          "type": "number",
          "minimum": 0
        },
        "total_initialization_cpu_seconds": {
          "type": "number",
          "minimum": 0
        },
        "total_run_wall_seconds": {
          "type": "number",
          "minimum": 0
        },
        "attempted_decisions": {
          "type": "integer",
          "minimum": 0
        },
        "completed_transitions": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_case_p95_inference_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "pairedSummary": {
      "type": "object",
      "required": [
        "completed_pairs",
        "candidate_only_victories",
        "reference_only_victories",
        "mean_maximum_floor_difference",
        "benchmark_denominator",
        "all_seed_candidate_only_victories",
        "all_seed_reference_only_victories",
        "victory_rate_difference",
        "victory_difference_interval_95",
        "interval_method",
        "failed_runs_count_as_non_victory",
        "paired_action_trace_changes"
      ],
      "properties": {
        "completed_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_only_victories": {
          "type": "integer",
          "minimum": 0
        },
        "reference_only_victories": {
          "type": "integer",
          "minimum": 0
        },
        "mean_maximum_floor_difference": {
          "type": "number"
        },
        "benchmark_denominator": {
          "type": "integer",
          "minimum": 1
        },
        "all_seed_candidate_only_victories": {
          "type": "integer",
          "minimum": 0
        },
        "all_seed_reference_only_victories": {
          "type": "integer",
          "minimum": 0
        },
        "victory_rate_difference": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "victory_difference_interval_95": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "interval_method": {
          "const": "bounded_paired_seed_hoeffding_independent_seed_assumption"
        },
        "failed_runs_count_as_non_victory": {
          "const": true
        },
        "paired_action_trace_changes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_scope": {
            "const": "paired_inspected_train_neural_selection_compatibility"
          }
        }
      },
      "then": {
        "properties": {
          "confirmation_config": {
            "$ref": "https://spireshift.dev/schemas/combat-policy-confirmation-config-v2.json"
          }
        }
      },
      "else": {
        "properties": {
          "confirmation_config": {
            "$ref": "https://spireshift.dev/schemas/combat-policy-confirmation-config-v1.json"
          }
        }
      }
    }
  ]
}
