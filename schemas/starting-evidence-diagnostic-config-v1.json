{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/starting-evidence-diagnostic-config-v1.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "starting-evidence-diagnostic-config-v1"
    },
    "objective_id": {
      "const": "terminal-victory-v1"
    },
    "training_config_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "candidate_model_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "candidate_report_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "resource_report_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "config_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "objective_id",
    "training_config_id",
    "candidate_model_id",
    "candidate_report_id",
    "resource_report_id",
    "config_id"
  ],
  "additionalProperties": false
}
