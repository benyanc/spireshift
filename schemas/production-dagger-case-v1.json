{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/production-dagger-case-v1.json",
  "title": "SpireShift Production DAgger Run v1",
  "type": "object",
  "required": [
    "schema_version", "case_id", "config_id", "seed", "partition", "model_id",
    "policy_id", "ruleset_manifest_id", "status", "error", "decisions", "terminal",
    "victory", "truncated", "termination_reason", "maximum_floor", "maximum_act",
    "final_state_hash", "action_trace_sha256", "fallback"
  ],
  "properties": {
    "schema_version": {"const": "production-dagger-case-v1"},
    "case_id": {"$ref": "#/$defs/id"},
    "config_id": {"$ref": "#/$defs/id"},
    "seed": {"type": "integer", "minimum": 0},
    "partition": {"const": "train"},
    "model_id": {"$ref": "#/$defs/id"},
    "policy_id": {"type": "string", "pattern": "^production-checkpoint-policy-v1:sha256:[a-f0-9]{64}$"},
    "ruleset_manifest_id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["completed", "failed"]},
    "error": {"type": ["string", "null"]},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "terminal": {"type": ["boolean", "null"]},
    "victory": {"type": ["boolean", "null"]},
    "truncated": {"type": ["boolean", "null"]},
    "termination_reason": {"enum": ["terminal", "policy_cycle", "decision_limit", null]},
    "maximum_floor": {"type": ["integer", "null"], "minimum": 0},
    "maximum_act": {"type": ["integer", "string", "null"]},
    "final_state_hash": {"type": ["string", "null"]},
    "action_trace_sha256": {"type": ["string", "null"]},
    "fallback": {"oneOf": [{"$ref": "#/$defs/fallback"}, {"type": "null"}]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "decision": {
      "type": "object",
      "required": [
        "decision_index", "decision_type", "decision_occurrence", "source_state_hash",
        "source_floor", "source_act", "representation_hash", "model_feature_digest",
        "legal_action_count", "eligible_action_count", "candidate_action_ids",
        "selected_candidate_index", "selected_action_id", "policy", "policy_confidence",
        "normalized_policy_entropy", "reference_frequency", "reference_fraction",
        "fallback_active", "selection_reasons", "selection_priority",
        "selected_for_relabeling", "next_state_hash", "public_state_changed",
        "terminal_after_action", "victory_after_action"
      ],
      "properties": {
        "decision_index": {"type": "integer", "minimum": 0},
        "decision_type": {"type": "string", "minLength": 1},
        "decision_occurrence": {"type": "integer", "minimum": 0},
        "source_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_floor": {"type": ["integer", "null"]},
        "source_act": {"type": ["integer", "string", "null"]},
        "representation_hash": {"$ref": "#/$defs/id"},
        "model_feature_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "legal_action_count": {"type": "integer", "minimum": 1},
        "eligible_action_count": {"type": "integer", "minimum": 1},
        "candidate_action_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "selected_candidate_index": {"type": "integer", "minimum": 0},
        "selected_action_id": {"type": "string", "minLength": 1},
        "policy": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rate"}},
        "policy_confidence": {"$ref": "#/$defs/rate"},
        "normalized_policy_entropy": {"$ref": "#/$defs/rate"},
        "reference_frequency": {"type": "integer", "minimum": 0},
        "reference_fraction": {"$ref": "#/$defs/rate"},
        "fallback_active": {"type": "boolean"},
        "selection_reasons": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["rare_reference_state", "high_policy_entropy", "terminal_frontier"]}
        },
        "selection_priority": {"$ref": "#/$defs/id"},
        "selected_for_relabeling": {"type": "boolean"},
        "next_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "public_state_changed": {"type": "boolean"},
        "terminal_after_action": {"type": "boolean"},
        "victory_after_action": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "fallback": {
      "type": "object",
      "required": [
        "schema_version", "controller_id", "repetition_threshold", "event_limit",
        "invocations", "suppressed_actions", "exhausted_states", "events"
      ],
      "properties": {
        "schema_version": {"const": "public-no-op-fallback-v1"},
        "controller_id": {"const": "public-no-op-action-guard-v1"},
        "repetition_threshold": {"type": "integer", "minimum": 1},
        "event_limit": {"type": "integer", "minimum": 1},
        "invocations": {"type": "integer", "minimum": 0},
        "suppressed_actions": {"type": "integer", "minimum": 0},
        "exhausted_states": {"type": "integer", "minimum": 0},
        "events": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
