{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/dagger-verification-v1.json",
  "title": "SpireShift DAgger Iteration Verification v1",
  "type": "object",
  "required": [
    "schema_version",
    "valid",
    "iteration_id",
    "runs",
    "decisions",
    "selected_for_relabel",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "dagger-verification-v1"},
    "valid": {"type": "boolean"},
    "iteration_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "runs": {"type": "integer", "minimum": 0},
    "decisions": {"type": "integer", "minimum": 0},
    "selected_for_relabel": {"type": "integer", "minimum": 0},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
