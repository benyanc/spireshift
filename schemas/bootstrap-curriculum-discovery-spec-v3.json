{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/bootstrap-curriculum-discovery-spec-v3.json",
  "title": "SpireShift Terminal-Frontier Curriculum Discovery Specification v3",
  "type": "object",
  "required": [
    "schema_version",
    "split_manifest_id",
    "ruleset_manifest_id",
    "objective_id",
    "capture_policy_id",
    "partition",
    "selection_policy",
    "run_count",
    "frontier_selection",
    "maximum_steps_per_run",
    "signal_spec"
  ],
  "properties": {
    "schema_version": {
      "const": "bootstrap-curriculum-discovery-spec-v3"
    },
    "split_manifest_id": {
      "$ref": "#/$defs/contentId"
    },
    "ruleset_manifest_id": {
      "$ref": "#/$defs/contentId"
    },
    "objective_id": {
      "const": "terminal-victory-v1"
    },
    "capture_policy_id": {
      "type": "string",
      "pattern": "^production-checkpoint-policy-v1:sha256:[a-f0-9]{64}$"
    },
    "partition": {
      "enum": [
        "train",
        "validation"
      ]
    },
    "selection_policy": {
      "type": "string",
      "minLength": 1
    },
    "run_count": {
      "type": "integer",
      "minimum": 1
    },
    "maximum_steps_per_run": {
      "type": "integer",
      "minimum": 1
    },
    "signal_spec": {
      "$ref": "#/$defs/signalSpec"
    },
    "frontier_selection": {
      "type": "object",
      "required": [
        "decision_types",
        "minimum_source_floor",
        "minimum_legal_actions",
        "maximum_states_per_run"
      ],
      "properties": {
        "decision_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "path",
              "combat",
              "combat_selection",
              "reward",
              "event",
              "rest_site",
              "shop",
              "treasure",
              "card_selection",
              "relic_selection",
              "mini_game"
            ]
          }
        },
        "minimum_source_floor": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_legal_actions": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_states_per_run": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "contentId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "signalSpec": {
      "type": "object",
      "required": [
        "minimum_states",
        "minimum_source_floors",
        "minimum_decision_types",
        "minimum_effective_labeled_states",
        "minimum_half_split_agreement",
        "minimum_occupied_maximum_floor_bins",
        "minimum_terminal_victories",
        "minimum_terminal_defeats",
        "minimum_states_with_candidate_terminal_variation"
      ],
      "properties": {
        "minimum_states": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_source_floors": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_decision_types": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_effective_labeled_states": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_half_split_agreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_occupied_maximum_floor_bins": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_terminal_victories": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_terminal_defeats": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_states_with_candidate_terminal_variation": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
