{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/split-manifest-v1.json",
  "title": "SpireShift Complete-Run Split Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "split_id",
    "ruleset_manifest_id",
    "objective_id",
    "unit",
    "seed_universe",
    "assignment",
    "encounter_policy",
    "partitions"
  ],
  "properties": {
    "schema_version": {"const": "split-manifest-v1"},
    "manifest_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "split_id": {"type": "string", "minLength": 1},
    "ruleset_manifest_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "objective_id": {"type": "string", "minLength": 1},
    "unit": {"const": "complete_run"},
    "seed_universe": {
      "type": "object",
      "required": ["start", "stop_exclusive"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "stop_exclusive": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "required": ["algorithm", "salt", "counts"],
      "properties": {
        "algorithm": {"const": "sha256-ranked-v1"},
        "salt": {"type": "string", "minLength": 1},
        "counts": {"$ref": "#/$defs/counts"}
      },
      "additionalProperties": false
    },
    "encounter_policy": {
      "type": "object",
      "required": [
        "unit",
        "inherits_split_from",
        "identifier_fields",
        "cross_partition_reuse"
      ],
      "properties": {
        "unit": {"const": "encounter_instance"},
        "inherits_split_from": {"const": "complete_run"},
        "identifier_fields": {
          "const": ["run_id", "encounter_id"]
        },
        "cross_partition_reuse": {"const": "forbidden"}
      },
      "additionalProperties": false
    },
    "partitions": {
      "type": "object",
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {"$ref": "#/$defs/seeds"},
        "validation": {"$ref": "#/$defs/seeds"},
        "test": {"$ref": "#/$defs/seeds"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {"type": "integer", "minimum": 0},
        "validation": {"type": "integer", "minimum": 0},
        "test": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "seeds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    }
  },
  "additionalProperties": false
}
