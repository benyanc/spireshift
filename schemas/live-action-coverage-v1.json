{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/live-action-coverage-v1.json",
  "title": "SpireShift Live Action Coverage Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "valid",
    "verdict",
    "coverage_id",
    "scope",
    "ruleset_manifest_id",
    "fixture_evidence",
    "run_evidence",
    "checks"
  ],
  "properties": {
    "schema_version": {"const": "live-action-coverage-v1"},
    "valid": {"type": "boolean"},
    "verdict": {"enum": ["pass", "conditional_pass", "fail"]},
    "coverage_id": {"type": "string", "minLength": 1},
    "scope": {"$ref": "live-action-coverage-spec-v1.json#/properties/scope"},
    "ruleset_manifest_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "fixture_evidence": {
      "type": "object",
      "required": [
        "corpus_sha256",
        "fixtures",
        "state_types",
        "decision_types",
        "action_kinds"
      ],
      "properties": {
        "corpus_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "fixtures": {"type": "integer", "minimum": 1},
        "state_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "decision_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "action_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "run_evidence": {
      "type": "object",
      "required": [
        "runs",
        "terminal_runs",
        "unsupported_runs",
        "unsupported_decisions",
        "records",
        "steps",
        "details"
      ],
      "properties": {
        "runs": {"type": "integer", "minimum": 1},
        "terminal_runs": {"type": "integer", "minimum": 0},
        "unsupported_runs": {"type": "integer", "minimum": 0},
        "unsupported_decisions": {"type": "integer", "minimum": 0},
        "records": {"type": "integer", "minimum": 1},
        "steps": {"type": "integer", "minimum": 0},
        "details": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/run"}
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_id", "status", "detail"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail"]},
          "detail": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "string_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "run": {
      "type": "object",
      "required": [
        "record_sha256",
        "records",
        "steps",
        "status",
        "reason",
        "terminal",
        "victory",
        "ruleset_manifest_ids",
        "characters",
        "ascensions",
        "selected_modes",
        "floor_range",
        "state_types",
        "decision_types",
        "advertised_action_kinds",
        "selected_action_kinds",
        "unsupported_decisions",
        "verification_errors"
      ],
      "properties": {
        "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "records": {"type": "integer", "minimum": 1},
        "steps": {"type": "integer", "minimum": 0},
        "status": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "terminal": {"type": "boolean"},
        "victory": {"type": ["boolean", "null"]},
        "ruleset_manifest_ids": {"$ref": "#/$defs/string_set"},
        "characters": {"$ref": "#/$defs/string_set"},
        "ascensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "selected_modes": {"$ref": "#/$defs/string_set"},
        "floor_range": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["minimum", "maximum"],
              "properties": {
                "minimum": {"type": "integer"},
                "maximum": {"type": "integer"}
              },
              "additionalProperties": false
            }
          ]
        },
        "state_types": {"$ref": "#/$defs/string_set"},
        "decision_types": {"$ref": "#/$defs/string_set"},
        "advertised_action_kinds": {"$ref": "#/$defs/string_set"},
        "selected_action_kinds": {"$ref": "#/$defs/string_set"},
        "unsupported_decisions": {"type": "integer", "minimum": 0},
        "verification_errors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
