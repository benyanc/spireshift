{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/teacher-dataset-verification-v1.json",
  "title": "SpireShift Teacher Dataset Verification v1",
  "type": "object",
  "required": [
    "schema_version",
    "valid",
    "dataset_id",
    "runs",
    "records",
    "search_simulations",
    "evaluation_simulations",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "teacher-dataset-verification-v1"},
    "valid": {"type": "boolean"},
    "dataset_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "runs": {"type": "integer", "minimum": 0},
    "records": {"type": "integer", "minimum": 0},
    "search_simulations": {"type": "integer", "minimum": 0},
    "evaluation_simulations": {"type": "integer", "minimum": 0},
    "errors": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
