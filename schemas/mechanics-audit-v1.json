{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/mechanics-audit-v1.json",
  "title": "SpireShift Mechanics Audit v1",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_id",
    "patch_id",
    "ruleset_manifest_id",
    "mechanics_service_id",
    "verdict",
    "probability_tolerance",
    "summary",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "mechanics-audit-v1"},
    "fixture_id": {"type": "string", "minLength": 1},
    "patch_id": {"type": "string", "minLength": 1},
    "ruleset_manifest_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "mechanics_service_id": {"const": "public-mechanics-v1"},
    "verdict": {"enum": ["pass", "diverged"]},
    "probability_tolerance": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {
      "type": "object",
      "required": [
        "cases",
        "exact_queries",
        "approximate_queries",
        "unavailable_queries",
        "divergences",
        "maximum_total_variation"
      ],
      "properties": {
        "cases": {"type": "integer", "minimum": 1},
        "exact_queries": {"type": "integer", "minimum": 0},
        "approximate_queries": {"type": "integer", "minimum": 0},
        "unavailable_queries": {"type": "integer", "minimum": 0},
        "divergences": {"type": "integer", "minimum": 0},
        "maximum_total_variation": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "seed",
          "state_hash",
          "legal_action_status",
          "outcomes",
          "divergences"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "seed": {"type": "integer"},
          "state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "legal_action_status": {"enum": ["pass", "diverged"]},
          "outcomes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "action_id",
                "method",
                "sample_count",
                "approximation_reason",
                "total_variation",
                "maximum_probability_error",
                "status"
              ],
              "properties": {
                "action_id": {"type": "string", "minLength": 1},
                "method": {
                  "enum": ["exact_enumeration", "public_resampling", "unavailable"]
                },
                "sample_count": {"type": "integer", "minimum": 0},
                "approximation_reason": {"type": ["string", "null"], "minLength": 1},
                "total_variation": {"type": "number", "minimum": 0, "maximum": 1},
                "maximum_probability_error": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "status": {"enum": ["pass", "diverged"]}
              },
              "additionalProperties": false
            }
          },
          "divergences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "expected", "actual"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "expected": {},
                "actual": {}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
