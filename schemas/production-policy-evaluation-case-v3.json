{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/production-policy-evaluation-case-v3.json",
  "title": "SpireShift Production Policy Evaluation Case v3",
  "type": "object",
  "required": [
    "schema_version", "case_id", "seed", "partition", "policy_kind", "policy_id",
    "model_id", "ruleset_manifest_id", "status", "error", "decisions", "terminal",
    "victory", "truncated", "termination_reason", "liveness", "fallback", "maximum_floor",
    "maximum_act", "final_state_hash", "action_trace_sha256", "total_decision_seconds",
    "median_decision_seconds", "maximum_decision_seconds"
  ],
  "properties": {
    "schema_version": {"const": "production-policy-evaluation-case-v3"},
    "case_id": {"$ref": "#/$defs/identifier"},
    "seed": {"type": "integer", "minimum": 0},
    "partition": {"enum": ["validation", "test"]},
    "policy_kind": {"enum": ["production_checkpoint", "progress_bootstrap_baseline"]},
    "policy_id": {"type": "string", "minLength": 1},
    "model_id": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
    "ruleset_manifest_id": {"$ref": "#/$defs/identifier"},
    "status": {"enum": ["completed", "failed"]},
    "error": {"type": ["string", "null"]},
    "decisions": {"type": ["integer", "null"], "minimum": 0},
    "terminal": {"type": ["boolean", "null"]},
    "victory": {"type": ["boolean", "null"]},
    "truncated": {"type": ["boolean", "null"]},
    "termination_reason": {
      "enum": ["terminal", "policy_cycle", "decision_limit", null]
    },
    "liveness": {"oneOf": [{"$ref": "#/$defs/liveness"}, {"type": "null"}]},
    "fallback": {"oneOf": [{"$ref": "#/$defs/fallback"}, {"type": "null"}]},
    "maximum_floor": {"type": ["integer", "null"], "minimum": 0},
    "maximum_act": {"type": ["integer", "null"], "minimum": 0},
    "final_state_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "action_trace_sha256": {
      "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "total_decision_seconds": {"type": ["number", "null"], "minimum": 0},
    "median_decision_seconds": {"type": ["number", "null"], "minimum": 0},
    "maximum_decision_seconds": {"type": ["number", "null"], "minimum": 0}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "stateHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableStateHash": {
      "oneOf": [{"$ref": "#/$defs/stateHash"}, {"type": "null"}]
    },
    "nullableNonemptyString": {"type": ["string", "null"], "minLength": 1},
    "nullableNonnegativeInteger": {"type": ["integer", "null"], "minimum": 0},
    "tailEntry": {
      "type": "object",
      "required": [
        "decision_index", "state_hash", "decision_type", "action_id", "next_state_hash",
        "public_state_changed"
      ],
      "properties": {
        "decision_index": {"type": "integer", "minimum": 0},
        "state_hash": {"$ref": "#/$defs/stateHash"},
        "decision_type": {"type": "string", "minLength": 1},
        "action_id": {"type": "string", "minLength": 1},
        "next_state_hash": {"$ref": "#/$defs/stateHash"},
        "public_state_changed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "liveness": {
      "type": "object",
      "required": [
        "schema_version", "cycle_detected", "classification", "repetition_threshold",
        "tail_limit", "maximum_state_action_repetitions",
        "maximum_public_transition_repetitions", "repeated_state_hash",
        "repeated_action_id", "repeated_next_state_hash", "decision_type",
        "first_occurrence_decision", "first_repeat_decision", "detection_decision",
        "repeated_transition_occurrences", "unchanged_transition_occurrences", "tail"
      ],
      "properties": {
        "schema_version": {"const": "policy-liveness-diagnostic-v1"},
        "cycle_detected": {"type": "boolean"},
        "classification": {
          "enum": ["unchanged_public_state_action", "repeated_public_transition", null]
        },
        "repetition_threshold": {"type": "integer", "minimum": 2},
        "tail_limit": {"type": "integer", "minimum": 1},
        "maximum_state_action_repetitions": {"type": "integer", "minimum": 0},
        "maximum_public_transition_repetitions": {"type": "integer", "minimum": 0},
        "repeated_state_hash": {"$ref": "#/$defs/nullableStateHash"},
        "repeated_action_id": {"$ref": "#/$defs/nullableNonemptyString"},
        "repeated_next_state_hash": {"$ref": "#/$defs/nullableStateHash"},
        "decision_type": {"$ref": "#/$defs/nullableNonemptyString"},
        "first_occurrence_decision": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "first_repeat_decision": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "detection_decision": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "repeated_transition_occurrences": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "unchanged_transition_occurrences": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "tail": {"type": "array", "items": {"$ref": "#/$defs/tailEntry"}}
      },
      "additionalProperties": false
    },
    "fallbackEvent": {
      "type": "object",
      "required": [
        "decision_index", "state_hash", "decision_type", "action_id",
        "unchanged_occurrences"
      ],
      "properties": {
        "decision_index": {"type": "integer", "minimum": 0},
        "state_hash": {"$ref": "#/$defs/stateHash"},
        "decision_type": {"type": "string", "minLength": 1},
        "action_id": {"type": "string", "minLength": 1},
        "unchanged_occurrences": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "fallback": {
      "type": "object",
      "required": [
        "schema_version", "controller_id", "repetition_threshold", "event_limit",
        "invocations", "suppressed_actions", "exhausted_states", "events"
      ],
      "properties": {
        "schema_version": {"const": "public-no-op-fallback-v1"},
        "controller_id": {"const": "public-no-op-action-guard-v1"},
        "repetition_threshold": {"type": "integer", "minimum": 1},
        "event_limit": {"type": "integer", "minimum": 1},
        "invocations": {"type": "integer", "minimum": 0},
        "suppressed_actions": {"type": "integer", "minimum": 0},
        "exhausted_states": {"type": "integer", "minimum": 0},
        "events": {"type": "array", "items": {"$ref": "#/$defs/fallbackEvent"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
