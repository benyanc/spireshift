{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/base-model-readiness-spec-v1.json",
  "title": "SpireShift Base-Model Readiness Specification v1",
  "type": "object",
  "required": [
    "schema_version", "scorecard_id", "name", "binding", "evaluation_contract",
    "thresholds", "claim_scope"
  ],
  "properties": {
    "schema_version": {"const": "base-model-readiness-spec-v1"},
    "scorecard_id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "binding": {
      "type": "object",
      "required": [
        "model_id", "training_report_id", "train_dataset_id", "validation_dataset_id",
        "split_manifest_id", "ruleset_manifest_id", "objective_id",
        "representation_encoder_id", "calibration_id"
      ],
      "properties": {
        "model_id": {"$ref": "#/$defs/id"},
        "training_report_id": {"$ref": "#/$defs/id"},
        "train_dataset_id": {"$ref": "#/$defs/id"},
        "validation_dataset_id": {"$ref": "#/$defs/id"},
        "split_manifest_id": {"$ref": "#/$defs/id"},
        "ruleset_manifest_id": {"$ref": "#/$defs/id"},
        "objective_id": {"const": "terminal-victory-v1"},
        "representation_encoder_id": {"const": "mechanics-compositional-v1"},
        "calibration_id": {"$ref": "#/$defs/nullableId"}
      },
      "additionalProperties": false
    },
    "evaluation_contract": {
      "type": "object",
      "required": [
        "partition", "seeds", "minimum_runs", "confidence_interval", "calibration_audit"
      ],
      "properties": {
        "partition": {"const": "validation"},
        "seeds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "minimum_runs": {"type": "integer", "minimum": 1},
        "confidence_interval": {
          "type": "object",
          "required": ["method", "confidence_level", "z"],
          "properties": {
            "method": {"const": "wilson-score-v1"},
            "confidence_level": {"const": 0.95},
            "z": {"const": 1.95996398454}
          },
          "additionalProperties": false
        },
        "calibration_audit": {
          "type": "object",
          "required": [
            "calibration_method", "fit_fraction", "split_salt", "calibration_bins",
            "minimum_decisions", "minimum_terminal_samples", "minimum_positive_outcomes",
            "minimum_negative_outcomes", "minimum_action_value_variation_decisions"
          ],
          "properties": {
            "calibration_method": {"const": "platt-logit-affine-v1"},
            "fit_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
            "split_salt": {"type": "string", "minLength": 1},
            "calibration_bins": {"type": "integer", "minimum": 2},
            "minimum_decisions": {"type": "integer", "minimum": 1},
            "minimum_terminal_samples": {"type": "integer", "minimum": 1},
            "minimum_positive_outcomes": {"type": "integer", "minimum": 1},
            "minimum_negative_outcomes": {"type": "integer", "minimum": 1},
            "minimum_action_value_variation_decisions": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": ["policy", "inference", "full_run", "calibration", "failures"],
      "properties": {
        "policy": {
          "type": "object",
          "required": [
            "minimum_decisive_pair_accuracy", "maximum_pairwise_cross_entropy",
            "maximum_mean_progress_regret", "minimum_tactical_risk_brier_skill",
            "maximum_tactical_risk_ece"
          ],
          "properties": {
            "minimum_decisive_pair_accuracy": {"$ref": "#/$defs/rate"},
            "maximum_pairwise_cross_entropy": {"type": "number", "minimum": 0},
            "maximum_mean_progress_regret": {"$ref": "#/$defs/rate"},
            "minimum_tactical_risk_brier_skill": {"type": "number"},
            "maximum_tactical_risk_ece": {"$ref": "#/$defs/rate"}
          },
          "additionalProperties": false
        },
        "inference": {
          "type": "object",
          "required": ["minimum_decisions", "maximum_p95_inference_seconds"],
          "properties": {
            "minimum_decisions": {"type": "integer", "minimum": 1},
            "maximum_p95_inference_seconds": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        },
        "full_run": {
          "type": "object",
          "required": [
            "minimum_victories", "minimum_defeats",
            "minimum_learned_victory_rate_lower_bound",
            "minimum_conservative_advantage_lower_bound"
          ],
          "properties": {
            "minimum_victories": {"type": "integer", "minimum": 1},
            "minimum_defeats": {"type": "integer", "minimum": 1},
            "minimum_learned_victory_rate_lower_bound": {"$ref": "#/$defs/rate"},
            "minimum_conservative_advantage_lower_bound": {"type": "number"}
          },
          "additionalProperties": false
        },
        "calibration": {
          "type": "object",
          "required": [
            "minimum_terminal_brier_skill", "maximum_terminal_ece",
            "maximum_mean_independent_regret", "maximum_p95_independent_regret"
          ],
          "properties": {
            "minimum_terminal_brier_skill": {"type": "number"},
            "maximum_terminal_ece": {"$ref": "#/$defs/rate"},
            "maximum_mean_independent_regret": {"$ref": "#/$defs/rate"},
            "maximum_p95_independent_regret": {"$ref": "#/$defs/rate"}
          },
          "additionalProperties": false
        },
        "failures": {
          "type": "object",
          "required": [
            "policy_confidence_threshold", "catastrophic_regret_threshold",
            "minimum_high_confidence_decisions",
            "maximum_high_confidence_catastrophic_errors",
            "maximum_high_confidence_catastrophic_rate",
            "false_safe_predicted_risk_threshold", "false_safe_observed_risk_threshold",
            "maximum_false_safe_tactical_risk_rate"
          ],
          "properties": {
            "policy_confidence_threshold": {"$ref": "#/$defs/rate"},
            "catastrophic_regret_threshold": {"$ref": "#/$defs/rate"},
            "minimum_high_confidence_decisions": {"type": "integer", "minimum": 1},
            "maximum_high_confidence_catastrophic_errors": {"type": "integer", "minimum": 0},
            "maximum_high_confidence_catastrophic_rate": {"$ref": "#/$defs/rate"},
            "false_safe_predicted_risk_threshold": {"$ref": "#/$defs/rate"},
            "false_safe_observed_risk_threshold": {"$ref": "#/$defs/rate"},
            "maximum_false_safe_tactical_risk_rate": {"$ref": "#/$defs/rate"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "claim_scope": {"const": "frozen_validation_base_model_readiness_contract"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "nullableId": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "rate": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
