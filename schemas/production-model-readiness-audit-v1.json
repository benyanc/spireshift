{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/production-model-readiness-audit-v1.json",
  "title": "SpireShift Production Model Readiness Audit v1",
  "type": "object",
  "required": [
    "schema_version", "audit_id", "model_id", "training_report_id",
    "validation_dataset_id", "split_manifest_id", "ruleset_manifest_id", "objective_id",
    "partition", "calibration", "configuration", "records", "summary", "claim_scope"
  ],
  "properties": {
    "schema_version": {"const": "production-model-readiness-audit-v1"},
    "audit_id": {"$ref": "#/$defs/id"},
    "model_id": {"$ref": "#/$defs/id"},
    "training_report_id": {"$ref": "#/$defs/id"},
    "validation_dataset_id": {"$ref": "#/$defs/id"},
    "split_manifest_id": {"$ref": "#/$defs/id"},
    "ruleset_manifest_id": {"$ref": "#/$defs/id"},
    "objective_id": {"const": "terminal-victory-v1"},
    "partition": {"const": "validation"},
    "calibration": {
      "type": "object",
      "required": [
        "calibration_id", "method", "fit_fraction", "split_salt", "fit_run_seeds",
        "audit_run_seeds"
      ],
      "properties": {
        "calibration_id": {"$ref": "#/$defs/id"},
        "method": {"const": "platt-logit-affine-v1"},
        "fit_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "split_salt": {"type": "string", "minLength": 1},
        "fit_run_seeds": {"$ref": "#/$defs/seeds"},
        "audit_run_seeds": {"$ref": "#/$defs/seeds"}
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "required": [
        "calibration_bins", "policy_confidence_threshold", "catastrophic_regret_threshold",
        "false_safe_predicted_risk_threshold", "false_safe_observed_risk_threshold"
      ],
      "properties": {
        "calibration_bins": {"type": "integer", "minimum": 2},
        "policy_confidence_threshold": {"$ref": "#/$defs/rate"},
        "catastrophic_regret_threshold": {"$ref": "#/$defs/rate"},
        "false_safe_predicted_risk_threshold": {"$ref": "#/$defs/rate"},
        "false_safe_observed_risk_threshold": {"$ref": "#/$defs/rate"}
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "record_id", "run_seed", "decision_index", "policy_confidence",
          "selected_candidate_index", "candidates"
        ],
        "properties": {
          "record_id": {"$ref": "#/$defs/id"},
          "run_seed": {"type": "integer", "minimum": 0},
          "decision_index": {"type": "integer", "minimum": 0},
          "policy_confidence": {"$ref": "#/$defs/rate"},
          "selected_candidate_index": {"type": "integer", "minimum": 0},
          "candidates": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "terminal_value_prediction", "terminal_outcomes",
                "tactical_risk_prediction", "tactical_death_outcomes"
              ],
              "properties": {
                "terminal_value_prediction": {"$ref": "#/$defs/rate"},
                "terminal_outcomes": {"$ref": "#/$defs/outcomes"},
                "tactical_risk_prediction": {"$ref": "#/$defs/rate"},
                "tactical_death_outcomes": {"$ref": "#/$defs/outcomes"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {"$ref": "#/$defs/summary"},
    "claim_scope": {"const": "independent_validation_calibration_and_failure_audit"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "seeds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "outcomes": {
      "type": "array", "minItems": 1,
      "items": {"type": "integer", "enum": [0, 1]}
    },
    "calibrationMetrics": {
      "type": "object",
      "required": [
        "samples", "outcome_prevalence", "brier_score", "constant_rate_brier_score",
        "brier_skill_score", "expected_calibration_error", "calibration_bins"
      ],
      "properties": {
        "samples": {"type": "integer", "minimum": 1},
        "outcome_prevalence": {"$ref": "#/$defs/rate"},
        "brier_score": {"$ref": "#/$defs/rate"},
        "constant_rate_brier_score": {"$ref": "#/$defs/rate"},
        "brier_skill_score": {"type": ["number", "null"]},
        "expected_calibration_error": {"$ref": "#/$defs/rate"},
        "calibration_bins": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["bin", "count", "mean_prediction", "observed_frequency"],
            "properties": {
              "bin": {"type": "integer", "minimum": 0},
              "count": {"type": "integer", "minimum": 1},
              "mean_prediction": {"$ref": "#/$defs/rate"},
              "observed_frequency": {"$ref": "#/$defs/rate"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "decisions", "terminal_samples", "terminal_victories", "terminal_defeats",
        "action_value_variation_decisions", "terminal_value", "tactical_death_risk",
        "independent_value_regret", "failure_analysis"
      ],
      "properties": {
        "decisions": {"type": "integer", "minimum": 1},
        "terminal_samples": {"type": "integer", "minimum": 1},
        "terminal_victories": {"type": "integer", "minimum": 0},
        "terminal_defeats": {"type": "integer", "minimum": 0},
        "action_value_variation_decisions": {"type": "integer", "minimum": 0},
        "terminal_value": {"$ref": "#/$defs/calibrationMetrics"},
        "tactical_death_risk": {"$ref": "#/$defs/calibrationMetrics"},
        "independent_value_regret": {
          "type": "object",
          "required": ["mean", "p95"],
          "properties": {"mean": {"$ref": "#/$defs/rate"}, "p95": {"$ref": "#/$defs/rate"}},
          "additionalProperties": false
        },
        "failure_analysis": {
          "type": "object",
          "required": [
            "high_confidence_decisions", "high_confidence_catastrophic_errors",
            "high_confidence_catastrophic_rate", "false_safe_tactical_risk_errors",
            "false_safe_tactical_risk_rate"
          ],
          "properties": {
            "high_confidence_decisions": {"type": "integer", "minimum": 0},
            "high_confidence_catastrophic_errors": {"type": "integer", "minimum": 0},
            "high_confidence_catastrophic_rate": {"$ref": "#/$defs/rate"},
            "false_safe_tactical_risk_errors": {"type": "integer", "minimum": 0},
            "false_safe_tactical_risk_rate": {"$ref": "#/$defs/rate"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
