{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/production-model-inference-smoke-v1.json",
  "title": "SpireShift Production Model Inference Smoke v1",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "model_id",
    "training_report_id",
    "policy_id",
    "ruleset_manifest_id",
    "patch_id",
    "information_policy_id",
    "seeds",
    "maximum_decisions_per_seed",
    "records",
    "summary",
    "claim_scope"
  ],
  "properties": {
    "schema_version": {"const": "production-model-inference-smoke-v1"},
    "report_id": {"$ref": "#/$defs/identifier"},
    "model_id": {"$ref": "#/$defs/identifier"},
    "training_report_id": {"$ref": "#/$defs/identifier"},
    "policy_id": {"type": "string", "minLength": 1},
    "ruleset_manifest_id": {"$ref": "#/$defs/identifier"},
    "patch_id": {"type": "string", "minLength": 1},
    "information_policy_id": {"const": "public-state-v1"},
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "maximum_decisions_per_seed": {"type": "integer", "minimum": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    },
    "summary": {
      "type": "object",
      "required": [
        "decisions",
        "terminal_seeds",
        "candidate_alignment_pass",
        "legal_selection_pass",
        "public_state_only",
        "median_inference_seconds",
        "p95_inference_seconds",
        "maximum_inference_seconds"
      ],
      "properties": {
        "decisions": {"type": "integer", "minimum": 1},
        "terminal_seeds": {"type": "integer", "minimum": 0},
        "candidate_alignment_pass": {"const": true},
        "legal_selection_pass": {"const": true},
        "public_state_only": {"const": true},
        "median_inference_seconds": {"type": "number", "minimum": 0},
        "p95_inference_seconds": {"type": "number", "minimum": 0},
        "maximum_inference_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "claim_scope": {"const": "admitted_backend_inference_smoke_only"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "record": {
      "type": "object",
      "required": [
        "run_seed",
        "decision_index",
        "decision_type",
        "state_hash",
        "representation_hash",
        "candidate_action_ids",
        "selected_candidate_index",
        "selected_action_id",
        "selected_policy_probability",
        "selected_tactical_death_risk",
        "inference_seconds"
      ],
      "properties": {
        "run_seed": {"type": "integer", "minimum": 0},
        "decision_index": {"type": "integer", "minimum": 0},
        "decision_type": {"type": "string", "minLength": 1},
        "state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "representation_hash": {"$ref": "#/$defs/identifier"},
        "candidate_action_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "selected_candidate_index": {"type": "integer", "minimum": 0},
        "selected_action_id": {"type": "string", "minLength": 1},
        "selected_policy_probability": {"$ref": "#/$defs/probability"},
        "selected_tactical_death_risk": {"$ref": "#/$defs/probability"},
        "inference_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
