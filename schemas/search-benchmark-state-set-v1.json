{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/search-benchmark-state-set-v1.json",
  "title": "SpireShift Search Benchmark State Set v1",
  "type": "object",
  "required": [
    "schema_version",
    "state_set_id",
    "split_manifest_id",
    "ruleset_manifest_id",
    "objective_id",
    "capture_policy_id",
    "partition",
    "selection_policy",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "search-benchmark-state-set-v1"},
    "state_set_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "split_manifest_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ruleset_manifest_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "objective_id": {"const": "terminal-victory-v1"},
    "capture_policy_id": {"const": "terminal-victory-search-rollout-v1"},
    "partition": {"const": "validation"},
    "selection_policy": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "state_id",
        "run_seed",
        "combat_state_index",
        "expected_state_hash",
        "expected_legal_actions"
      ],
      "properties": {
        "state_id": {"type": "string", "minLength": 1},
        "run_seed": {"type": "integer", "minimum": 0},
        "combat_state_index": {"type": "integer", "minimum": 0},
        "expected_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "expected_legal_actions": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
