{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/bootstrap-teacher-dataset-v1.json",
  "title": "SpireShift Bootstrap Teacher Dataset v1",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "teacher_id",
    "utility_id",
    "seed_protocol_id",
    "objective_id",
    "objective",
    "auxiliary_reward_allowed",
    "backend",
    "state_set",
    "configuration",
    "started_at",
    "completed_at",
    "cases",
    "summary",
    "claim_scope"
  ],
  "properties": {
    "schema_version": {"const": "bootstrap-teacher-dataset-v1"},
    "dataset_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "teacher_id": {"const": "paired-terminal-dominant-progress-teacher-v1"},
    "utility_id": {"const": "terminal-dominant-floor-act-hp-v1"},
    "seed_protocol_id": {"const": "sha256-paired-bootstrap-v1"},
    "objective_id": {"const": "terminal-victory-v1"},
    "objective": {
      "type": "object",
      "required": ["id", "primary", "constraint", "whole_run_budget", "auxiliary", "auxiliary_reward_allowed"],
      "properties": {
        "id": {"const": "terminal-victory-v1"},
        "primary": {"const": "terminal_victory"},
        "constraint": {"const": "cpu_time_per_run"},
        "whole_run_budget": {"type": "integer", "minimum": 1},
        "auxiliary": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "auxiliary_reward_allowed": {"const": false}
      },
      "additionalProperties": false
    },
    "auxiliary_reward_allowed": {"const": false},
    "backend": {"type": "object"},
    "state_set": {"$ref": "bootstrap-state-set-v1.json"},
    "configuration": {
      "type": "object",
      "required": ["samples_per_candidate", "sampling_seed", "maximum_prefix_steps", "maximum_rollout_steps", "workers", "worker_timeout_seconds"],
      "properties": {
        "samples_per_candidate": {"type": "integer", "minimum": 1},
        "sampling_seed": {"type": "integer", "minimum": 0},
        "maximum_prefix_steps": {"type": "integer", "minimum": 1},
        "maximum_rollout_steps": {"type": "integer", "minimum": 1},
        "workers": {"type": "integer", "minimum": 1},
        "worker_timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["state_id", "path", "sha256", "case_id"],
        "properties": {
          "state_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "case_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["benchmark_denominator", "completed_cases", "failed_cases", "records", "candidates", "simulations", "transitions", "terminal_victories", "states_with_candidate_progress_variation", "occupied_maximum_floor_bins", "completion_rate"],
      "properties": {
        "benchmark_denominator": {"type": "integer", "minimum": 1},
        "completed_cases": {"type": "integer", "minimum": 0},
        "failed_cases": {"type": "integer", "minimum": 0},
        "records": {"type": "integer", "minimum": 0},
        "candidates": {"type": "integer", "minimum": 0},
        "simulations": {"type": "integer", "minimum": 0},
        "transitions": {"type": "integer", "minimum": 0},
        "terminal_victories": {"type": "integer", "minimum": 0},
        "states_with_candidate_progress_variation": {"type": "integer", "minimum": 0},
        "occupied_maximum_floor_bins": {"type": "integer", "minimum": 0},
        "completion_rate": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "claim_scope": {"const": "train_curriculum_only"}
  },
  "additionalProperties": false
}
