{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/fixed-search-verification-v1.json",
  "title": "SpireShift Fixed-Budget Search Verification v1",
  "type": "object",
  "required": [
    "schema_version",
    "valid",
    "report_id",
    "tiers",
    "simulations",
    "verified_worker_batches",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "fixed-search-verification-v1"},
    "valid": {"type": "boolean"},
    "report_id": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "tiers": {"type": "integer", "minimum": 0},
    "simulations": {"type": "integer", "minimum": 0},
    "verified_worker_batches": {"type": "integer", "minimum": 0},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
