{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/rollout-batch-replay-v1.json",
  "title": "SpireShift Rollout Batch Replay Result v1",
  "type": "object",
  "required": ["schema_version", "valid", "runs", "verified_runs", "errors"],
  "properties": {
    "schema_version": {"const": "rollout-batch-replay-v1"},
    "valid": {"type": "boolean"},
    "runs": {"type": "integer", "minimum": 0},
    "verified_runs": {"type": "integer", "minimum": 0},
    "errors": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
