{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/bootstrap-state-set-v6.json",
  "title": "SpireShift Exact Milestone-Trajectory State Set v6",
  "type": "object",
  "required": [
    "schema_version",
    "state_set_id",
    "split_manifest_id",
    "ruleset_manifest_id",
    "objective_id",
    "capture_policy_id",
    "partition",
    "selection_policy",
    "discovery",
    "signal_spec",
    "cases",
    "capture_policy",
    "capture_trajectory"
  ],
  "properties": {
    "schema_version": {"const": "bootstrap-state-set-v6"},
    "state_set_id": {"$ref": "#/$defs/contentId"},
    "split_manifest_id": {"$ref": "#/$defs/contentId"},
    "ruleset_manifest_id": {"$ref": "#/$defs/contentId"},
    "objective_id": {"const": "terminal-victory-v1"},
    "capture_policy_id": {
      "type": "string",
      "pattern": "^production-checkpoint-policy-v1:sha256:[a-f0-9]{64}$"
    },
    "partition": {"const": "train"},
    "selection_policy": {
      "type": "string",
      "pattern": "^accepted-milestone-trajectory-v1:sha256:[a-f0-9]{64}$"
    },
    "discovery": {"$ref": "#/$defs/discovery"},
    "signal_spec": {
      "$ref": "bootstrap-curriculum-discovery-spec-v2.json#/$defs/signalSpec"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    },
    "capture_policy": {
      "$ref": "bootstrap-state-set-v3.json#/$defs/policyProvenance"
    },
    "capture_trajectory": {"$ref": "#/$defs/captureTrajectory"}
  },
  "additionalProperties": false,
  "$defs": {
    "contentId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decisionType": {
      "enum": [
        "path", "combat", "combat_selection", "reward", "event", "rest_site",
        "shop", "treasure", "card_selection", "relic_selection", "mini_game"
      ]
    },
    "case": {
      "type": "object",
      "required": [
        "state_id", "run_seed", "decision_type", "decision_index",
        "expected_state_hash", "expected_legal_actions", "expected_source_floor",
        "expected_source_act", "trajectory_decision_index",
        "expected_selected_action_id", "expected_next_state_hash"
      ],
      "properties": {
        "state_id": {"type": "string", "minLength": 1},
        "run_seed": {"type": "integer", "minimum": 0},
        "decision_type": {"$ref": "#/$defs/decisionType"},
        "decision_index": {"type": "integer", "minimum": 0},
        "expected_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "expected_legal_actions": {"type": "integer", "minimum": 1},
        "expected_source_floor": {"type": ["integer", "null"]},
        "expected_source_act": {"type": ["integer", "string", "null"]},
        "trajectory_decision_index": {"type": "integer", "minimum": 0},
        "expected_selected_action_id": {"type": "string", "minLength": 1},
        "expected_next_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "required": [
        "schema_version", "exact_replay", "search_report_id", "search_verification_id",
        "search_case_id", "trajectory_id", "capture_trajectory_id",
        "replayed_decisions", "maximum_steps_per_run", "mutation_lineage_count", "selection",
        "requested_coordinates", "captured_coordinates", "excluded_duplicate_states",
        "excluded_dataset_ids", "source_maximum_floor", "boss_reached",
        "act1_cleared", "terminal", "victory"
      ],
      "properties": {
        "schema_version": {"const": "milestone-trajectory-discovery-v1"},
        "exact_replay": {"const": true},
        "search_report_id": {"$ref": "#/$defs/contentId"},
        "search_verification_id": {"$ref": "#/$defs/contentId"},
        "search_case_id": {"$ref": "#/$defs/contentId"},
        "trajectory_id": {"$ref": "#/$defs/contentId"},
        "capture_trajectory_id": {"$ref": "#/$defs/contentId"},
        "replayed_decisions": {"type": "integer", "minimum": 1},
        "maximum_steps_per_run": {"type": "integer", "minimum": 1},
        "mutation_lineage_count": {"type": "integer", "minimum": 1},
        "selection": {"type": "object"},
        "requested_coordinates": {"type": "integer", "minimum": 1},
        "captured_coordinates": {"type": "integer", "minimum": 1},
        "excluded_duplicate_states": {"type": "integer", "minimum": 0},
        "excluded_dataset_ids": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/contentId"}
        },
        "source_maximum_floor": {"type": "integer", "minimum": 1},
        "boss_reached": {"const": true},
        "act1_cleared": {"const": false},
        "terminal": {"const": true},
        "victory": {"const": false}
      },
      "additionalProperties": false
    },
    "captureTrajectory": {
      "type": "object",
      "required": [
        "schema_version", "capture_trajectory_id", "search_report_id",
        "search_verification_id", "search_config_id", "search_case_id", "trajectory_id",
        "lineage_trajectory_ids", "mutation_lineage", "run_seed", "ruleset_manifest_id",
        "hidden_state_resampling", "action_trace_sha256", "maximum_floor", "boss_reached",
        "act1_cleared", "terminal", "victory", "final_state_hash",
        "no_op_fallback_threshold", "liveness_tail_length", "decisions"
      ],
      "properties": {
        "schema_version": {"const": "milestone-trajectory-replay-v1"},
        "capture_trajectory_id": {"$ref": "#/$defs/contentId"},
        "search_report_id": {"$ref": "#/$defs/contentId"},
        "search_verification_id": {"$ref": "#/$defs/contentId"},
        "search_config_id": {"$ref": "#/$defs/contentId"},
        "search_case_id": {"$ref": "#/$defs/contentId"},
        "trajectory_id": {"$ref": "#/$defs/contentId"},
        "lineage_trajectory_ids": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"$ref": "#/$defs/contentId"}
        },
        "mutation_lineage": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "run_seed": {"type": "integer", "minimum": 0},
        "ruleset_manifest_id": {"$ref": "#/$defs/contentId"},
        "hidden_state_resampling": {"const": false},
        "action_trace_sha256": {"$ref": "#/$defs/contentId"},
        "maximum_floor": {"type": "integer", "minimum": 1},
        "boss_reached": {"const": true},
        "act1_cleared": {"const": false},
        "terminal": {"const": true},
        "victory": {"const": false},
        "final_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "no_op_fallback_threshold": {"type": "integer", "minimum": 1},
        "liveness_tail_length": {"type": "integer", "minimum": 1},
        "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "decision_index", "decision_type", "source_state_hash", "source_floor", "source_act",
        "candidate_action_ids", "selected_action_id", "selection_source", "next_state_hash",
        "terminal_after_action", "victory_after_action"
      ],
      "properties": {
        "decision_index": {"type": "integer", "minimum": 0},
        "decision_type": {"$ref": "#/$defs/decisionType"},
        "source_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_floor": {"type": ["integer", "null"]},
        "source_act": {"type": ["integer", "string", "null"]},
        "candidate_action_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "selected_action_id": {"type": "string", "minLength": 1},
        "selection_source": {"type": "string", "minLength": 1},
        "next_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "terminal_after_action": {"type": "boolean"},
        "victory_after_action": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
