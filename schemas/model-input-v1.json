{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/model-input-v1.json",
  "title": "SpireShift Compositional Model Input v1",
  "type": "object",
  "required": [
    "schema_version",
    "encoder_id",
    "representation_hash",
    "ruleset_manifest_id",
    "patch_id",
    "observation_schema",
    "source_state_hash",
    "decision_type",
    "state",
    "candidates",
    "action_mask"
  ],
  "properties": {
    "schema_version": {"const": "model-input-v1"},
    "encoder_id": {"const": "mechanics-compositional-v1"},
    "representation_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ruleset_manifest_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "patch_id": {"type": "string", "minLength": 1},
    "observation_schema": {"type": "string", "minLength": 1},
    "source_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision_type": {
      "enum": [
        "menu",
        "path",
        "combat",
        "combat_selection",
        "reward",
        "event",
        "rest_site",
        "shop",
        "treasure",
        "card_selection",
        "relic_selection",
        "mini_game",
        "terminal",
        "unknown"
      ]
    },
    "state": {
      "type": "object",
      "required": ["global_features", "persistent_resources", "entities"],
      "properties": {
        "global_features": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
        "persistent_resources": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
        "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}}
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "action_mask": {
      "type": "array",
      "items": {"const": true}
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": [
        "path",
        "indices",
        "semantic",
        "value_type",
        "numeric_value",
        "categorical_value",
        "boolean_value"
      ],
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"}
        },
        "indices": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "semantic": {
          "enum": [
            "mechanic",
            "persistent_resource",
            "status",
            "capability",
            "locator",
            "progression",
            "identity"
          ]
        },
        "value_type": {"enum": ["boolean", "numeric", "categorical", "null"]},
        "numeric_value": {"type": ["number", "null"]},
        "categorical_value": {"type": ["string", "null"]},
        "boolean_value": {"type": ["boolean", "null"]}
      },
      "oneOf": [
        {
          "properties": {
            "value_type": {"const": "numeric"},
            "numeric_value": {"type": "number"},
            "categorical_value": {"type": "null"},
            "boolean_value": {"type": "null"}
          }
        },
        {
          "properties": {
            "value_type": {"const": "categorical"},
            "numeric_value": {"type": "null"},
            "categorical_value": {"type": "string"},
            "boolean_value": {"type": "null"}
          }
        },
        {
          "properties": {
            "value_type": {"const": "boolean"},
            "numeric_value": {"type": "null"},
            "categorical_value": {"type": "null"},
            "boolean_value": {"type": "boolean"}
          }
        },
        {
          "properties": {
            "value_type": {"const": "null"},
            "numeric_value": {"type": "null"},
            "categorical_value": {"type": "null"},
            "boolean_value": {"type": "null"}
          }
        }
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["entity_type", "path", "indices", "features"],
      "properties": {
        "entity_type": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"}
        },
        "indices": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_index", "source_action_id", "action_kind", "features"],
      "properties": {
        "candidate_index": {"type": "integer", "minimum": 0},
        "source_action_id": {"type": "string", "minLength": 1},
        "action_kind": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
