{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/production-model-checkpoint-v6.json",
  "title": "SpireShift Anchored Trajectory Policy Checkpoint v6",
  "type": "object",
  "required": [
    "schema_version",
    "model_id",
    "model_type",
    "representation_encoder_id",
    "vectorizer_id",
    "ruleset_manifest_id",
    "objective_id",
    "split_manifest_id",
    "train_dataset_id",
    "training_config",
    "heads",
    "trajectory_finetuning"
  ],
  "properties": {
    "schema_version": {
      "const": "production-model-checkpoint-v6"
    },
    "model_id": {
      "$ref": "https://spireshift.dev/schemas/production-model-checkpoint-v3.json#/properties/model_id"
    },
    "model_type": {
      "const": "sparse-anchored-trajectory-policy-v1"
    },
    "representation_encoder_id": {
      "$ref": "https://spireshift.dev/schemas/production-model-checkpoint-v3.json#/properties/representation_encoder_id"
    },
    "vectorizer_id": {
      "$ref": "https://spireshift.dev/schemas/production-model-checkpoint-v3.json#/properties/vectorizer_id"
    },
    "ruleset_manifest_id": {
      "$ref": "https://spireshift.dev/schemas/production-model-checkpoint-v3.json#/properties/ruleset_manifest_id"
    },
    "objective_id": {
      "$ref": "https://spireshift.dev/schemas/production-model-checkpoint-v3.json#/properties/objective_id"
    },
    "split_manifest_id": {
      "$ref": "https://spireshift.dev/schemas/production-model-checkpoint-v3.json#/properties/split_manifest_id"
    },
    "train_dataset_id": {
      "$ref": "https://spireshift.dev/schemas/production-model-checkpoint-v3.json#/properties/train_dataset_id"
    },
    "training_config": {
      "$ref": "https://spireshift.dev/schemas/production-model-checkpoint-v3.json#/properties/training_config"
    },
    "heads": {
      "$ref": "https://spireshift.dev/schemas/production-model-checkpoint-v3.json#/properties/heads"
    },
    "trajectory_finetuning": {
      "$ref": "https://spireshift.dev/schemas/trajectory-policy-training-config-v1.json#/$defs/binding"
    }
  },
  "additionalProperties": false
}
