{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/starting-option-policy-training-config-v2.json",
  "type": "object",
  "required": [
    "schema_version",
    "config_id",
    "encoder_id",
    "dimension",
    "evidence_recipe"
  ],
  "properties": {
    "schema_version": {
      "const": "starting-option-policy-training-config-v2"
    },
    "config_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "encoder_id": {
      "const": "starting-ancient-public-option-v1"
    },
    "dimension": {
      "type": "integer",
      "minimum": 128,
      "maximum": 65536
    },
    "evidence_recipe": {
      "$ref": "https://spireshift.dev/schemas/starting-evidence-policy-training-config-v1.json"
    }
  },
  "additionalProperties": false
}
