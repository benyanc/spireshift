{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/bound-action-v1.json",
  "title": "SpireShift Bound Action v1",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "manifest_id",
    "patch_id",
    "state_hash",
    "action_id"
  ],
  "properties": {
    "schema_version": {"const": "bound-action-v1"},
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "manifest_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "patch_id": {"type": "string", "minLength": 1},
    "state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "action_id": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
