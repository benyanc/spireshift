{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/model-calibration-v1.json",
  "title": "SpireShift Model Calibration v1",
  "type": "object",
  "required": [
    "schema_version",
    "calibration_id",
    "method",
    "model_id",
    "validation_dataset_id",
    "split_manifest_id",
    "ruleset_manifest_id",
    "objective_id",
    "configuration",
    "subfold",
    "heads",
    "claim_scope"
  ],
  "properties": {
    "schema_version": {"const": "model-calibration-v1"},
    "calibration_id": {"$ref": "#/$defs/id"},
    "method": {"const": "platt-logit-affine-v1"},
    "model_id": {"$ref": "#/$defs/id"},
    "validation_dataset_id": {"$ref": "#/$defs/id"},
    "split_manifest_id": {"$ref": "#/$defs/id"},
    "ruleset_manifest_id": {"$ref": "#/$defs/id"},
    "objective_id": {"type": "string", "minLength": 1},
    "configuration": {"$ref": "#/$defs/configuration"},
    "subfold": {"$ref": "#/$defs/subfold"},
    "heads": {
      "type": "object",
      "required": ["run_value", "tactical_death_risk"],
      "properties": {
        "run_value": {"$ref": "#/$defs/head"},
        "tactical_death_risk": {"$ref": "#/$defs/head"}
      },
      "additionalProperties": false
    },
    "claim_scope": {"const": "mock_pipeline_validation"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "configuration": {
      "type": "object",
      "required": [
        "fit_fraction",
        "split_salt",
        "iterations",
        "learning_rate",
        "l2_regularization",
        "gradient_clip",
        "calibration_bins",
        "policy_confidence_threshold",
        "catastrophic_regret_threshold",
        "false_safe_risk_threshold",
        "false_safe_observed_rate"
      ],
      "properties": {
        "fit_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "split_salt": {"type": "string", "minLength": 1},
        "iterations": {"type": "integer", "minimum": 1},
        "learning_rate": {"type": "number", "exclusiveMinimum": 0},
        "l2_regularization": {"type": "number", "minimum": 0},
        "gradient_clip": {"type": "number", "exclusiveMinimum": 0},
        "calibration_bins": {"type": "integer", "minimum": 2},
        "policy_confidence_threshold": {"$ref": "#/$defs/probability"},
        "catastrophic_regret_threshold": {"$ref": "#/$defs/probability"},
        "false_safe_risk_threshold": {"$ref": "#/$defs/probability"},
        "false_safe_observed_rate": {"$ref": "#/$defs/probability"}
      },
      "additionalProperties": false
    },
    "subfold": {
      "type": "object",
      "required": ["method", "fit_run_ids", "audit_run_ids"],
      "properties": {
        "method": {"const": "sha256-model-salt-run-ranking-v1"},
        "fit_run_ids": {"$ref": "#/$defs/runIds"},
        "audit_run_ids": {"$ref": "#/$defs/runIds"}
      },
      "additionalProperties": false
    },
    "runIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "head": {
      "type": "object",
      "required": ["slope", "intercept", "fit_samples", "fit_positive_rate"],
      "properties": {
        "slope": {"type": "number"},
        "intercept": {"type": "number"},
        "fit_samples": {"type": "integer", "minimum": 1},
        "fit_positive_rate": {"$ref": "#/$defs/probability"}
      },
      "additionalProperties": false
    }
  }
}
