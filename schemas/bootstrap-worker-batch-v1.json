{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/bootstrap-worker-batch-v1.json",
  "title": "SpireShift Bootstrap Worker Batch v1",
  "type": "object",
  "required": ["schema_version", "batch_report_id", "batch_id", "started_at", "completed_at", "configuration", "summary", "tasks"],
  "properties": {
    "schema_version": {"const": "bootstrap-worker-batch-v1"},
    "batch_report_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "batch_id": {"type": "string", "format": "uuid"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "configuration": {
      "type": "object",
      "required": ["workers", "worker_timeout_seconds", "task_ids"],
      "properties": {
        "workers": {"type": "integer", "minimum": 1},
        "worker_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["requested_tasks", "completed_tasks", "failed_tasks", "transitions", "worker_cpu_seconds", "wall_seconds"],
      "properties": {
        "requested_tasks": {"type": "integer", "minimum": 1},
        "completed_tasks": {"type": "integer", "minimum": 0},
        "failed_tasks": {"type": "integer", "minimum": 0},
        "transitions": {"type": "integer", "minimum": 0},
        "worker_cpu_seconds": {"type": "number", "minimum": 0},
        "wall_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "status", "exit_code", "worker_pid", "message", "request_path", "result_path", "request_sha256", "result_sha256", "cpu_seconds", "wall_seconds", "output"],
        "properties": {
          "task_id": {"type": "string", "format": "uuid"},
          "status": {"enum": ["completed", "worker_error", "crashed", "timeout"]},
          "exit_code": {"type": ["integer", "null"]},
          "worker_pid": {"type": ["integer", "null"]},
          "message": {"type": "string", "minLength": 1},
          "request_path": {"type": "string", "minLength": 1},
          "result_path": {"type": "string", "minLength": 1},
          "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "result_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "cpu_seconds": {"type": ["number", "null"], "minimum": 0},
          "wall_seconds": {"type": ["number", "null"], "minimum": 0},
          "output": {"type": ["object", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
