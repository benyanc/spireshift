{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/terminal-trajectory-discovery-v1.json",
  "title": "SpireShift Terminal Trajectory Discovery v1",
  "type": "object",
  "required": [
    "schema_version", "report_id", "started_at", "completed_at", "config_id",
    "model_id", "training_report_id", "split_manifest_id", "partition",
    "ruleset_manifest_id", "patch_id", "objective_id", "configuration", "cases",
    "winning_cases", "summary", "readiness", "claim_scope"
  ],
  "properties": {
    "schema_version": {"const": "terminal-trajectory-discovery-v1"},
    "report_id": {"$ref": "#/$defs/id"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "config_id": {"$ref": "#/$defs/id"},
    "model_id": {"$ref": "#/$defs/id"},
    "training_report_id": {"$ref": "#/$defs/id"},
    "split_manifest_id": {"$ref": "#/$defs/id"},
    "partition": {"const": "train"},
    "ruleset_manifest_id": {"$ref": "#/$defs/id"},
    "patch_id": {"type": "string", "minLength": 1},
    "objective_id": {"const": "terminal-victory-v1"},
    "configuration": {"$ref": "terminal-trajectory-discovery-config-v1.json"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
    "winning_cases": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "summary": {"type": "object"},
    "readiness": {
      "type": "object",
      "required": [
        "terminal_positive_trajectories_found", "terminal_value_head_unblocked",
        "recommended_next_step"
      ],
      "properties": {
        "terminal_positive_trajectories_found": {"type": "boolean"},
        "terminal_value_head_unblocked": {"type": "boolean"},
        "recommended_next_step": {
          "enum": ["replay_and_label_winning_trajectories", "escalate_to_run_level_search"]
        }
      },
      "additionalProperties": false
    },
    "claim_scope": {"const": "train_only_terminal_trajectory_discovery"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "required": ["seed", "profile_name", "attempt", "path", "case_id"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0},
        "profile_name": {"type": "string", "minLength": 1},
        "attempt": {"type": "integer", "minimum": 0},
        "path": {"type": "string", "minLength": 1},
        "case_id": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
