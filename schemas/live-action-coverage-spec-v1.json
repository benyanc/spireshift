{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/live-action-coverage-spec-v1.json",
  "title": "SpireShift Live Action Coverage Specification v1",
  "type": "object",
  "required": [
    "schema_version",
    "coverage_id",
    "ruleset_manifest_id",
    "scope",
    "required_state_types",
    "required_decision_types",
    "required_action_kinds",
    "minimum_terminal_runs"
  ],
  "properties": {
    "schema_version": {"const": "live-action-coverage-spec-v1"},
    "coverage_id": {"type": "string", "minLength": 1},
    "ruleset_manifest_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "scope": {
      "type": "object",
      "required": ["character", "difficulty"],
      "properties": {
        "character": {"type": "string", "minLength": 1},
        "difficulty": {
          "type": "object",
          "required": ["mode", "ascension"],
          "properties": {
            "mode": {"type": "string", "minLength": 1},
            "ascension": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "required_state_types": {"$ref": "#/$defs/nonempty_string_set"},
    "required_decision_types": {"$ref": "#/$defs/nonempty_string_set"},
    "required_action_kinds": {"$ref": "#/$defs/nonempty_string_set"},
    "minimum_terminal_runs": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "nonempty_string_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
