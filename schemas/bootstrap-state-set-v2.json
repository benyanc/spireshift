{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/bootstrap-state-set-v2.json",
  "title": "SpireShift Bootstrap Curriculum State Set v2",
  "type": "object",
  "required": ["schema_version", "state_set_id", "split_manifest_id", "ruleset_manifest_id", "objective_id", "capture_policy_id", "partition", "selection_policy", "discovery", "signal_spec", "cases"],
  "properties": {
    "schema_version": {"const": "bootstrap-state-set-v2"},
    "state_set_id": {"$ref": "#/$defs/contentId"},
    "split_manifest_id": {"$ref": "#/$defs/contentId"},
    "ruleset_manifest_id": {"$ref": "#/$defs/contentId"},
    "objective_id": {"const": "terminal-victory-v1"},
    "capture_policy_id": {"const": "public-progress-bootstrap-v1"},
    "partition": {"enum": ["train", "validation"]},
    "selection_policy": {"type": "string", "minLength": 1},
    "discovery": {
      "type": "object",
      "required": ["schema_version", "requested_runs", "maximum_steps_per_run", "decision_occurrences", "requested_coordinates", "captured_coordinates", "unreachable_coordinates", "terminal_runs", "step_limited_runs"],
      "properties": {
        "schema_version": {"const": "bootstrap-curriculum-discovery-v1"},
        "requested_runs": {"type": "integer", "minimum": 1},
        "maximum_steps_per_run": {"type": "integer", "minimum": 1},
        "decision_occurrences": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}},
        "requested_coordinates": {"type": "integer", "minimum": 1},
        "captured_coordinates": {"type": "integer", "minimum": 1},
        "unreachable_coordinates": {"type": "array", "items": {"$ref": "#/$defs/unreachable"}},
        "terminal_runs": {"type": "integer", "minimum": 0},
        "step_limited_runs": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "signal_spec": {"$ref": "bootstrap-curriculum-discovery-spec-v1.json#/$defs/signalSpec"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "additionalProperties": false,
  "$defs": {
    "contentId": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "case": {
      "type": "object",
      "required": ["state_id", "run_seed", "decision_type", "decision_index", "expected_state_hash", "expected_legal_actions", "expected_source_floor", "expected_source_act"],
      "properties": {
        "state_id": {"type": "string", "minLength": 1},
        "run_seed": {"type": "integer", "minimum": 0},
        "decision_type": {"enum": ["path", "combat", "combat_selection", "reward", "event", "rest_site", "shop", "treasure", "card_selection", "relic_selection", "mini_game"]},
        "decision_index": {"type": "integer", "minimum": 0},
        "expected_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "expected_legal_actions": {"type": "integer", "minimum": 1},
        "expected_source_floor": {"type": ["integer", "null"]},
        "expected_source_act": {"type": ["integer", "string", "null"]}
      },
      "additionalProperties": false
    },
    "unreachable": {
      "type": "object",
      "required": ["run_seed", "decision_type", "decision_index", "reason"],
      "properties": {
        "run_seed": {"type": "integer", "minimum": 0},
        "decision_type": {"type": "string", "minLength": 1},
        "decision_index": {"type": "integer", "minimum": 0},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
