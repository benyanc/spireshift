{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spireshift.dev/schemas/combat-search-diagnostic-spec-v1.json",
  "title": "SpireShift Combat Search Diagnostic Specification v1",
  "type": "object",
  "required": [
    "schema_version", "spec_id", "split_manifest_id", "ruleset_manifest_id",
    "objective_id", "model_id", "training_report_id", "partition", "run_offset",
    "run_count", "workers", "maximum_decisions_per_run", "cycle_repetition_threshold",
    "variants"
  ],
  "properties": {
    "schema_version": {"const": "combat-search-diagnostic-spec-v1"},
    "spec_id": {"$ref": "#/$defs/id"},
    "split_manifest_id": {"$ref": "#/$defs/id"},
    "ruleset_manifest_id": {"$ref": "#/$defs/id"},
    "objective_id": {"const": "terminal-victory-v1"},
    "model_id": {"$ref": "#/$defs/id"},
    "training_report_id": {"$ref": "#/$defs/id"},
    "partition": {"const": "train"},
    "run_offset": {"type": "integer", "minimum": 0},
    "run_count": {"type": "integer", "minimum": 1},
    "workers": {"type": "integer", "minimum": 1},
    "maximum_decisions_per_run": {"type": "integer", "minimum": 1},
    "cycle_repetition_threshold": {"type": "integer", "minimum": 2},
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "combat_advancement_config"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "combat_advancement_config": {
            "oneOf": [
              {"$ref": "https://spireshift.dev/schemas/combat-advancement-config-v2.json"},
              {"$ref": "https://spireshift.dev/schemas/combat-advancement-config-v3.json"}
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}},
  "additionalProperties": false
}
