<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(NativeMatrix)' != 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(NativeMatrix)' == 'true'">net9.0</TargetFramework>
    <DefineConstants Condition="'$(NativeMatrix)' == 'true'">$(DefineConstants);NATIVE_MATRIX</DefineConstants>
    <OutputType>Exe</OutputType>
    <AssemblyName>STS2Connector.Host.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(HostProject)" />
    <Reference Include="Sts2Headless"><HintPath>$(NativeCandidate)/src/Sts2Headless/bin/Release/net9.0/Sts2Headless.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="sts2"><HintPath>$(NativeCandidate)/lib/sts2.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(NativeCandidate)/src/GodotStubs/bin/Release/net9.0/GodotSharp.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.CodeAnalysis" Condition="'$(NativeMatrix)' != 'true'"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp" Condition="'$(NativeMatrix)' != 'true'"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
