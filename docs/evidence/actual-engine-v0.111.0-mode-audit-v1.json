    "findings": [
      {
        "classification": "rules_rng_divergence",
        "method": "MegaCrit.Sts2.Core.Models.Relics.CallingBell.GenerateRewards",
        "rationale": "Test mode returns three predetermined relic rewards rather than the native rarity-pool draws. The v10 wrapper has no restoration for this method; seeded reward and RNG-counter differentials are required."
      },
      {
        "classification": "rules_rng_divergence",
        "method": "MegaCrit.Sts2.Core.Models.Relics.Cauldron.GenerateRewards",
        "rationale": "Test mode uses preset potion models instead of the normal generated potion rewards. The v10 wrapper has no restoration for this method; generated offers, capacity choices and RNG consumption need comparison."
      },
      {
        "classification": "profile_dependent_rules",
        "method": "MegaCrit.Sts2.Core.Models.ActModel.GetRandomList",
        "rationale": "The normal undiscovered alternative-act preference is skipped in test mode. A fully unlocked content policy does not specify discovered acts. Freeze the progress/discovery contract and compare initial act choices and RNG advancement."
      },
      {
        "classification": "choice_or_lifecycle_seam",
        "method": "MegaCrit.Sts2.Core.Commands.CardSelectCmd.FromChooseABundleScreen",
        "rationale": "Test mode takes the first bundle without a player choice. The current nine native selection observation boundaries do not include this bundle method. Preserve advertised bundle choice and selection synchronization before qualifying it."
      },
      {
        "classification": "choice_or_lifecycle_seam",
        "method": "MegaCrit.Sts2.Core.Commands.CardSelectCmd.Reset",
        "rationale": "Native selector-stack cleanup is conditional on test mode being off. Interrupted selections and repeated resets need a bound clean-state test; wrapper scope disposal alone is not proof that all native stacks reset."
      },
      {
        "classification": "choice_or_lifecycle_seam",
        "method": "MegaCrit.Sts2.Core.Rewards.RewardsSet.Offer",
        "rationale": "Test mode uses a test selector or selects rewards automatically. The v10 wrapper installs its reward selector in both start and load paths. This is a declared control seam that needs multi-reward, capacity and cancellation coverage rather than assuming the branch harmless."
      },
      {
        "classification": "choice_or_lifecycle_seam",
        "method": "MegaCrit.Sts2.Core.Models.Powers.RollingBoulderPower.AfterPlayerTurnStart",
        "rationale": "Test mode applies damage to the enemy list directly; the normal path schedules damage per visual-hit callback. Death and on-damage ordering need a differential with multiple enemies; batching cannot be declared presentation-only."
      },
      {
        "classification": "choice_or_lifecycle_seam",
        "method": "MegaCrit.Sts2.Core.Entities.RestSite.RestSiteOption.Generate",
        "rationale": "A non-null test generator replaces native rest-option generation. Assert it remains unset in production collection and across resets. Existing finite rest fixtures do not establish all hook/option coverage."
      },
      {
        "classification": "profile_dependent_rules",
        "method": "MegaCrit.Sts2.Core.Runs.RunRngSet.GetMockInstance",
        "rationale": "Test mode allows a fallback mock RNG when no run is attached. Ensure gameplay models use the active run and player RNGs; model-preview use is separate from seeded gameplay. No fallback reachability claim follows static reading."
      },
      {
        "classification": "rules_rng_divergence",
        "method": "MegaCrit.Sts2.Core.Entities.Merchant.MerchantPotionEntry.CalcCost",
        "rationale": "Original test-mode branch skips price RNG. The current v9/v10 wrapper restores this exact branch and the eight-case v2 shop panel verifies scoped price/effect agreement. This is a known scoped mitigation, not a new unfixed price regression."
      }
    ],
