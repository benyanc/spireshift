  "source_findings": [
    {
      "finding": "Before the final act, the game enters the next act. It does not compare total floor with a map-local boss row.",
      "method": "EnterNextAct",
      "rule": "earlier_boss_reward_advances_to_next_act",
      "source_type": "MegaCrit.Sts2.Core.Runs.RunManager"
    },
    {
      "finding": "Changing act resets ActFloor; TotalFloor counts the accumulated map-point history across acts.",
      "method": "CurrentActIndex, ActFloor, TotalFloor",
      "rule": "total_floor_is_distinct_from_act_progress",
      "source_type": "MegaCrit.Sts2.Core.Runs.RunState"
    },
    {
      "finding": "After the final boss, the real UI enters the Architect scene. Every settled dialogue screen offers one continuation; its final Proceed requests victory. The simulator collapses this forced closing sequence, so it does not match the UI step for step.",
      "method": "EnterNextAct, GenerateInitialOptions, AdvanceDialogue, WinRun",
      "rule": "ending_includes_forced_architect_dialogue",
      "source_type": "MegaCrit.Sts2.Core.Runs.RunManager and MegaCrit.Sts2.Core.Models.Events.TheArchitect"
    },
    {
      "finding": "A8 includes earlier difficulty effects and ToughEnemies. DoubleBoss is level 10, so it is inactive at A8.",
      "method": "GenerateRooms and HasLevel",
      "rule": "a8_is_not_a0_or_double_boss",
      "source_type": "MegaCrit.Sts2.Core.Entities.Ascension.AscensionLevel and MegaCrit.Sts2.Core.Runs.RunManager"
    }
  ],
