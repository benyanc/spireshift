+    // Keep these rewards in the exact game's normal branch while other headless
+    // presentation paths retain TestMode. Constructors, Populate, pools and RNG
+    // remain game-owned; changed method bodies fail before interception.
+    // A separately versioned benchmark profile, constructed from this exact game's registries.
+    // Never changes a real account. Every worker receives a fresh serialized copy.
+    internal static class NativeBenchmarkProfile
+    {
+        internal const string Policy = "native_benchmark_full_v1";
+        internal static void Install()
+        {
+            var all = UnlockState.all.ToSerializable();
+            var serialized = new SerializableProgress
+            {
+                UniqueId = "spireshift-benchmark-full-v1",
+                EnableFtues = true,
+                Epochs = all.UnlockedEpochs.Select(id => new SerializableEpoch(id,
+                    EpochState.Revealed) { ObtainDate = 0 }).ToList(),
+                EncounterStats = all.EncountersSeen.Select(id => new EncounterStats { Id = id }).ToList(),
+                CharStats = new List<CharacterStats> { new CharacterStats
+                {
+                    Id = ModelDb.Character<Ironclad>().Id,
+                    MaxAscension = 8, PreferredAscension = 8, TotalLosses = all.NumberOfRuns
+                } },
+                DiscoveredActs = ModelDb.ActsByIndex.SelectMany(row => row).Select(act => act.Id).Distinct().ToList(),
+                DiscoveredCards = UnlockState.all.Cards.Select(card => card.Id).Distinct().ToList(),
+                DiscoveredRelics = UnlockState.all.Relics.Select(relic => relic.Id).Distinct().ToList(),
+                DiscoveredPotions = UnlockState.all.Potions.Select(potion => potion.Id).Distinct().ToList(),
+                DiscoveredEvents = ModelDb.AllEvents.Select(model => model.Id).Distinct().ToList(),
+            };
+            var context = new MegaCrit.Sts2.Core.Saves.Validation.DeserializationContext();
+            var progress = ProgressState.FromSerializable(serialized, context);
+            if (context.Errors.Count != 0)
+                throw new InvalidOperationException("Benchmark progress failed native validation: " + string.Join("; ", context.Errors));
+            SaveManager.Instance.Progress = progress;
+            AssertInstalled();
+        }
+        internal static void AssertInstalled()
+        {
+            var actual = SaveManager.Instance.GenerateUnlockStateFromProgress().ToSerializable();
+            var expected = UnlockState.all.ToSerializable();
+            var progress = SaveManager.Instance.Progress;
+            if (!actual.UnlockedEpochs.ToHashSet().SetEquals(expected.UnlockedEpochs)
+                || !actual.EncountersSeen.ToHashSet().SetEquals(expected.EncountersSeen)
+                || actual.NumberOfRuns != expected.NumberOfRuns
+                || !progress.DiscoveredActs.SetEquals(ModelDb.ActsByIndex.SelectMany(row => row).Select(act => act.Id))
+                || !progress.EnableFtues || progress.FtueCompleted.Count != 0
+                || progress.GetOrCreateCharacterStats(ModelDb.Character<Ironclad>().Id).MaxAscension != 8)
+                throw new InvalidOperationException("Benchmark unlock/discovery/tutorial profile changed");
+        }
+    }
