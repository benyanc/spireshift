+    private Dictionary<string, CardModel> ConfiguredCoverageVariants()
+    {
+        var player = _runState?.Players.Single()
+            ?? throw new InvalidOperationException("Configured coverage inventory requires a private fixture start");
+        var nativeEvent = (MegaCrit.Sts2.Core.Models.Events.TinkerTime)
+            ModelDb.GetById<EventModel>(new ModelId("EVENT", "TINKER_TIME")).ToMutable();
+        nativeEvent.BeginEvent(player, null, false).GetAwaiter().GetResult();
+        var variants = new Dictionary<string, CardModel>(StringComparer.Ordinal);
+        foreach (var type in new[] { CardType.Attack, CardType.Skill, CardType.Power })
+        {
+            var chooseType = nativeEvent.GetType().GetMethod(type.ToString(),
+                BindingFlags.NonPublic | BindingFlags.Instance)
+                ?? throw new MissingMethodException("Native Tinker Time card-type choice changed");
+            for (var attempt = 0; attempt < 32; attempt++)
+            {
+                ((Task)chooseType.Invoke(nativeEvent, null)!).GetAwaiter().GetResult();
+                foreach (var card in nativeEvent.CurrentOptions.SelectMany(option => option.HoverTips)
+                    .OfType<CardHoverTip>().Select(tip => tip.Card)
+                    .OfType<MegaCrit.Sts2.Core.Models.Cards.MadScience>())
+                {
+                    if (card.TinkerTimeType != type || card.TinkerTimeRider == MegaCrit.Sts2.Core.Models.Events.TinkerTime.RiderEffect.None)
+                        throw new InvalidOperationException("Native Tinker Time returned an incomplete card preview");
+                    var id = $"{card.TinkerTimeType}-{card.TinkerTimeRider}".ToLowerInvariant();
+                    variants.TryAdd(id, card);
+                }
+                if (variants.Values.Count(card => card.Type == type) == 3) break;
+            }
+            if (variants.Values.Count(card => card.Type == type) != 3)
+                throw new InvalidOperationException("Native configured-card variant inventory is incomplete");
+        }
+        return variants;
+    }
