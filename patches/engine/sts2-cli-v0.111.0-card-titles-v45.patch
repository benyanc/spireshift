+// Version-bound replacement for the presentation screen, not for event/game logic.
+// The original option still pays gold / obtains the curse, and the original model
+// creates the grid, consumes divinations, reveals items and awards native rewards.
+internal static class HeadlessCrystalSphere
+{
+    private static bool _installed;
+    public static CrystalSphereMinigame? Active;
+    public static bool IsChoosing => Active is { DivinationCount: > 0 };
+    private static readonly FieldInfo Completion = AccessTools.Field(typeof(CrystalSphereMinigame), "_completionSource");
+    private static readonly MethodInfo Complete = AccessTools.Method(typeof(CrystalSphereMinigame), "CompleteMinigame");
+
+    public static void Install()
+    {
+        if (_installed) return;
+        new Harmony("spireshift.crystal-sphere.public-screen.v1").Patch(
+            AccessTools.Method(typeof(CrystalSphereMinigame), "PlayMinigame"),
+            prefix: new HarmonyMethod(typeof(HeadlessCrystalSphere), nameof(Play)));
+        _installed = true;
+    }
+
+    private static bool Play(CrystalSphereMinigame __instance, ref Task __result)
+    {
+        if (!TestMode.IsOn) return true;
+        if (Active != null) throw new InvalidOperationException("Another crystal grid is awaiting a choice");
+        Active = __instance;
+        __result = AwaitChoices(__instance);
+        return false;
+    }
+
+    private static async Task AwaitChoices(CrystalSphereMinigame game)
+    {
+        await ((TaskCompletionSource)Completion.GetValue(game)!).Task;
+        // Native completion owns reward synchronization/selection, not the grid screen.
+        try { await (Task)Complete.Invoke(game, null)!; }
+        finally { Active = null; }
+    }
+
+    private static Array Cells(CrystalSphereMinigame game) =>
+        (Array)AccessTools.Field(typeof(CrystalSphereMinigame), "cells").GetValue(game)!;
+
+    private static Array Tools => Enum.GetValues(typeof(CrystalSphereMinigame)
+        .GetProperty("CrystalSphereTool")!.PropertyType).Cast<object>()
+        .Where(tool => Convert.ToInt32(tool) != 0).ToArray();
+
+    public static async Task Choose(int index)
+    {
+        var game = Active ?? throw new InvalidOperationException("No current crystal grid");
+        var cells = Cells(game); var count = cells.Length;
+        if (game.DivinationCount <= 0 || index < 0 || index >= count * Tools.Length)
+            throw new InvalidOperationException("Choice outside the current crystal grid");
+        var tool = Tools.GetValue(index / count)!;
+        AccessTools.Method(typeof(CrystalSphereMinigame), "SetTool").Invoke(game, new[] { tool });
+        // Fixed x-major ordering, including already clear cells as on the shipped grid.
+        var cell = cells.GetValue((index % count) / cells.GetLength(1), index % cells.GetLength(1))!;
+        await (Task)AccessTools.Method(typeof(CrystalSphereMinigame), "CellClicked").Invoke(game, new[] { cell })!;
+    }
+
+    public static Dictionary<string, object?> Observe(object context, object player)
+    {
+        var game = Active ?? throw new InvalidOperationException("No current crystal grid");
+        var cells = Cells(game); var grid = new List<string>();
+        // Never inspect Item/Position/Size/Rewards for a fogged cell. Hidden layout/RNG
+        // remains native only. A partially visible item's other covered cells stay hidden.
+        for (var x = 0; x < cells.GetLength(0); x++)
+            for (var y = 0; y < cells.GetLength(1); y++)
+            {
+                var cell = (CrystalSphereCell)cells.GetValue(x, y)!;
+                var visible = cell.IsHidden ? "covered" : cell.Item?.GetType().Name ?? "empty";
+                grid.Add($"({x},{y}): {visible}");
+            }
+        var description = $"Divinations remaining: {game.DivinationCount}. Visible grid: " + string.Join("; ", grid);
+        var options = new List<Dictionary<string, object?>>();
+        foreach (var tool in Tools)
+            for (var x = 0; x < cells.GetLength(0); x++)
+                for (var y = 0; y < cells.GetLength(1); y++)
+                    options.Add(new()
+                    {
+                        ["index"] = options.Count,
+                        ["title"] = $"{tool} at ({x},{y})",
+                        ["description"] = $"Use {tool} on visible grid coordinate ({x},{y}).",
+                        ["is_locked"] = false,
+                    });
+        return new()
+        {
+            ["type"] = "decision", ["decision"] = "event_choice",
+            ["event_id"] = "CRYSTAL_SPHERE", ["event_name"] = "Crystal Sphere — grid",
+            ["description"] = description, ["options"] = options,
+            ["context"] = context, ["player"] = player,
+        };
+    }
+}
