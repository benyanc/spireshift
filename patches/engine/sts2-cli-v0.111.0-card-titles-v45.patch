+    public Dictionary<string, object?> ExportBenchmarkProfile(string? outputPath)
+    {
+        if (_contentPolicy != NativeBenchmarkProfile.Policy || _runState == null)
+            return Error("A declared active benchmark-profile run is required");
+        NativeBenchmarkProfile.AssertInstalled();
+        var progress = SaveManager.Instance.Progress.ToSerializable();
+        var migrations = typeof(SaveManager).GetField("_migrationManager", BindingFlags.Instance | BindingFlags.NonPublic)
+            ?.GetValue(SaveManager.Instance) as MegaCrit.Sts2.Core.Saves.Migrations.MigrationManager
+            ?? throw new MissingFieldException("Exact native progress migration registry missing");
+        progress.SchemaVersion = migrations.GetLatestVersion<SerializableProgress>();
+        var json = JsonSerializationUtility.ToJson(progress);
+        if (outputPath != null)
+        {
+            if (File.Exists(outputPath)) throw new IOException("Preserve the existing benchmark profile export");
+            Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(outputPath))!);
+            File.WriteAllText(outputPath, json);
+        }
+        return new Dictionary<string, object?>
+        {
+            ["type"] = "benchmark_profile", ["profile_policy"] = NativeBenchmarkProfile.Policy,
+            ["privileged_debug_metadata"] = true, ["progress"] = progress,
+            ["progress_json_sha256"] = Convert.ToHexStringLower(System.Security.Cryptography.SHA256.HashData(
+                System.Text.Encoding.UTF8.GetBytes(json))), ["path"] = outputPath,
+            ["all_acts_discovered"] = true, ["fresh_tutorials"] = true,
+        };
+    }
