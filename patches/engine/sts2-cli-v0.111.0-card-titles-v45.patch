+    internal static class NativePotionPricing
+    {
+        private static bool _installed;
+        internal static bool Installed => _installed;
+        internal static void Install()
+        {
+            if (_installed) return;
+            var method = typeof(MerchantPotionEntry).GetMethod(nameof(MerchantPotionEntry.CalcCost))
+                ?? throw new MissingMethodException("Exact native potion price method missing");
+            var rewrite = typeof(NativePotionPricing).GetMethod(nameof(ShippedBranch), BindingFlags.Static | BindingFlags.NonPublic)
+                ?? throw new MissingMethodException("Potion pricing transpiler missing");
