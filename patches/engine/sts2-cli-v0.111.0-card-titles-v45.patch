+            _installed = true;
+        }
+        private static IEnumerable<CodeInstruction> ShippedBranch(IEnumerable<CodeInstruction> instructions)
+        {
+            var code = instructions.ToList();
+            var getter = typeof(TestMode).GetProperty(nameof(TestMode.IsOff))?.GetMethod
+                ?? throw new MissingMethodException("Exact native TestMode pricing branch missing");
+            var gates = code.Where(row => row.Calls(getter)).ToArray();
+            if (gates.Length != 1) throw new InvalidOperationException("Expected exactly one potion-price TestMode branch");
+            gates[0].opcode = OpCodes.Ldc_I4_1;
+            gates[0].operand = null;
+            return code;
+        }
