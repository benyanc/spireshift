+    private List<Dictionary<string, object?>> PublicEventHoverTips(IEnumerable<IHoverTip> tips)
+    {
+        var result = new List<Dictionary<string, object?>>();
+        foreach (var tip in IHoverTip.RemoveDupes(tips))
+        {
+            switch (tip)
+            {
+                case HoverTip text:
+                    result.Add(new Dictionary<string, object?> {
+                        ["kind"] = "text", ["name"] = StripVisibleText(text.Title),
+                        ["description"] = StripVisibleText(text.Description), ["card"] = null });
+                    break;
+                case CardHoverTip card:
+                    result.Add(new Dictionary<string, object?> {
+                        ["kind"] = "card", ["name"] = null, ["description"] = null,
+                        ["card"] = VisibleHoverCard(card.Card) });
+                    break;
+                default:
+                    throw new NotSupportedException($"Unsupported public event hover: {tip.GetType().Name}");
+            }
+        }
+        return result;
+    }
