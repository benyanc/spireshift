     /// When the game needs the player to choose cards (upgrade, remove, transform, bundle pick),
     /// this stores the options and waits for the main loop to provide the answer.
     /// </summary>
+    internal static class SelectionPreferenceCapture
+    {
+        private static readonly AsyncLocal<CardSelectorPrefs?> Scope = new();
+        private static bool _installed;
+        private static bool _failed;
+        public static int InstalledCommands { get; private set; }
+        public static CardSelectorPrefs? Current => Scope.Value;
+
+        public static void Install()
+        {
+            if (_failed) throw new InvalidOperationException("Selection preference instrumentation failed; replace this process");
+            if (_installed) return;
+            var specs = new (string Name, int Count, Type? First)[]
+            {
+                (nameof(CardSelectCmd.FromSimpleGridForRewards), 4, null),
+                (nameof(CardSelectCmd.FromSimpleGrid), 4, null),
+                (nameof(CardSelectCmd.FromCombatPile), 5, null),
+                (nameof(CardSelectCmd.FromDeckForTransformation), 3, null),
+                (nameof(CardSelectCmd.FromDeckForEnchantment), 4, typeof(IReadOnlyList<CardModel>)),
+                (nameof(CardSelectCmd.FromDeckGeneric), 4, null),
+                (nameof(CardSelectCmd.FromHand), 5, null),
+            };
+            var methods = typeof(CardSelectCmd).GetMethods(BindingFlags.Public | BindingFlags.Static);
+            var targets = specs.Select(spec => methods.Single(method => method.Name == spec.Name
+                && method.GetParameters().Length == spec.Count
+                && (spec.First == null || method.GetParameters()[0].ParameterType == spec.First)
+                && method.GetParameters().Any(parameter => parameter.Name == "prefs" && parameter.ParameterType == typeof(CardSelectorPrefs)))).ToList();
+            try
+            {
+                var harmony = new Harmony("spireshift.native-selection-preferences-v1");
+                var flags = BindingFlags.Public | BindingFlags.Static;
+                foreach (var target in targets)
+                {
+                    harmony.Patch(target,
+                        prefix: new HarmonyMethod(typeof(SelectionPreferenceCapture).GetMethod(nameof(Enter), flags)),
+                        postfix: new HarmonyMethod(typeof(SelectionPreferenceCapture).GetMethod(nameof(Exit), flags)),
+                        finalizer: new HarmonyMethod(typeof(SelectionPreferenceCapture).GetMethod(nameof(Finish), flags)));
+                    InstalledCommands++;
+                }
+                _installed = true;
+            }
+            catch { _failed = true; throw; }
+        }
+
+        public static void Enter(CardSelectorPrefs prefs, out CardSelectorPrefs? __state)
+        {
+            __state = Scope.Value;
+            Scope.Value = prefs;
+        }
+        public static void Exit(CardSelectorPrefs? __state) => Scope.Value = __state;
+        public static Exception? Finish(Exception? __exception, CardSelectorPrefs? __state)
+        {
+            Scope.Value = __state;
+            return __exception;
+        }
+    }
