@@ -0,0 +1,46 @@
+using STS2Connector.LiveHost;
+using STS2Connector.LiveHost.Contracts;
+using STS2Connector.NativeUi;
+using STS2Connector.PlayerEnvironment;
+namespace STS2Connector.Tests;
+
+public sealed class CombatDiscardContractTests
+{
+    [Theory]
+    [InlineData(true, true, true, false, true)]
+    [InlineData(false, true, true, false, false)]
+    [InlineData(true, false, true, false, false)]
+    [InlineData(true, true, false, false, false)]
+    [InlineData(true, true, true, true, false)]
+    public void DiscardRequiresReadyPermissionOwnerAndNoQueuedEffect(bool ready, bool permission,
+        bool owner, bool queued, bool expected) =>
+        Assert.Equal(expected, CombatTurnSurfaceReader.DiscardPermission(ready, permission, owner, queued));
+
+    [Fact]
+    public void IdenticalPotionNamesKeepDistinctExactSlots()
+    {
+        var surface = new CombatTurnSurface("combat_turn", "room", true)
+        {
+            DiscardablePotions = new[] { new VisibleCombatDiscardOption("p0", "Same potion", 0),
+                new VisibleCombatDiscardOption("p1", "Same potion", 1) }
+        };
+        Assert.Equal(0, NativeUiActionRuntime.ExactDiscardSlot(surface, "p0"));
+        Assert.Equal(1, NativeUiActionRuntime.ExactDiscardSlot(surface, "p1"));
+        var actions = NativeUiActionRuntime.DescribeCombatCommands(surface).Where(a => a.Kind == "discard_potion").ToArray();
+        Assert.Equal(2, actions.Length);
+        Assert.NotEqual(actions[0].Key, actions[1].Key);
+        Assert.All(actions, a => Assert.Equal("discard_potion", a.Kind));
+        Assert.Equal("activate", PlayerEnvironmentService.GenericAction("discard_potion", "discard_potion"));
+    }
+
+    [Fact]
+    public void EmptyOrAmbiguousSlotsAreNotAdvertised()
+    {
+        var surface = new CombatTurnSurface("combat_turn", "room", true);
+        Assert.Null(NativeUiActionRuntime.ExactDiscardSlot(surface, "absent"));
+        surface = surface with { DiscardablePotions = new[] {
+            new VisibleCombatDiscardOption("p0", "Potion", 0), new VisibleCombatDiscardOption("p1", "Potion", 0) } };
+        Assert.Null(NativeUiActionRuntime.ExactDiscardSlot(surface, "p0"));
+        Assert.DoesNotContain(NativeUiActionRuntime.DescribeCombatCommands(surface), a => a.Kind == "discard_potion");
+    }
+}
