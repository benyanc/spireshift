+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using MegaCrit.Sts2.Core.CardSelection;
+using STS2Connector.LiveHost;
+using STS2Connector.LiveHost.Contracts;
+using STS2Connector.PlayerEnvironment;
+using STS2Connector.PlayerEnvironment.Protocol;
+namespace STS2Connector.NativeUi;
+
+internal sealed record AtomicChoiceRoot(AtomicSelectionView View,JsonObject Surface,CardSelectorPrefs Preferences,
+    IReadOnlyList<NativeUiBoundAction> Primitives,IReadOnlyList<NativeUiBoundAction> Choices);
+internal static class AtomicCardSelection
+{
+    internal const string Protocol="atomic_public_card_choice_v1";
+    private static readonly HashSet<string> Families=new(){"native_deck_card_selection","deck_upgrade_selection",
+        "deck_transform_selection","deck_enchant_selection","native_simple_card_selection","native_combat_pile_selection","combat_hand_card_selection"};
+    private sealed record Transaction(string Request,string Snapshot,string Owner,AtomicSelectionKernel Kernel,DateTime Deadline,
+        List<object> Steps,IReadOnlyList<string> Chosen,bool Cancel,bool Auto,int Maximum,JsonObject RootUi);
+    private static Transaction? Active;
+    private static object? last;
+    internal static object? Provenance()=>last;
+    internal static bool IsFamily(string kind)=>Families.Contains(kind);
+    private static string[] Strings(JsonObject s,string k)=>(s[k] as JsonArray??new()).Select(x=>x!.GetValue<string>()).ToArray();
+    private static bool Flag(JsonObject s,string k)=>s[k]?.GetValue<bool>()==true;
+    internal static AtomicChoiceRoot? Read(LiveObservation draft,NativeEntityRegistry entities,bool choices)
+    {
+        if(!IsFamily(draft.Surface.Kind))return null;
+        var raw=(JsonObject)JsonSerializer.SerializeToNode(draft.Surface,draft.Surface.GetType(),ConnectorMod._jsonOptions)!;
+        string owner=(raw["screen_entity_id"]??raw["hand_entity_id"])!.GetValue<string>();
+        if(!entities.TryResolve(owner,out object? screen)||screen==null
+            ||!BoundedCardSelectionFacts.TryRead(screen,out var prefs,out _,out var error))
+            throw new InvalidOperationException("Atomic selector preferences are unavailable");
+        var cards=(JsonArray)raw["cards"]!;
+        var ids=cards.Select(c=>c!["entity_id"]!.GetValue<string>()).ToArray();
+        var primitive=PlayerEnvironmentService.BuildPrimitiveBindings(draft);
+        // Only immutable/current visible card facts; selected state belongs to the
+        // transaction and is checked separately. The original envelope is logged.
+        var facts=new JsonArray();
+        foreach(var node in cards.OrderBy(n=>n!["entity_id"]!.GetValue<string>(),StringComparer.Ordinal))
+        {var c=(JsonObject)node!;var copy=(JsonObject)c.DeepClone();copy.Remove("is_selected");facts.Add(copy);}
+        string hash=StableIdentityHash.Object(new {cards=facts, prefs.MinSelect,prefs.MaxSelect,prefs.Cancelable,
+            prefs.RequireManualConfirmation,prefs.UnpoweredPreviews,prefs.PretendCardsCanBePlayed});
+        var view=new AtomicSelectionView(owner,draft.Surface.Kind,hash,raw["stage"]?.GetValue<string>()??"selecting",
+            Strings(raw,"selected_card_entity_ids"),Strings(raw,"selectable_card_entity_ids"),Flag(raw,"can_preview"),
+            Flag(raw,"can_confirm"),Flag(raw,"can_cancel_selection")||Flag(raw,"can_cancel"),Flag(raw,"can_cancel_preview"));
+        var surface=new JsonObject { ["kind"]="card_selection",["stage"]="choosing",["cards"]=cards.DeepClone(),
+            ["min_select"]=prefs.MinSelect,["max_select"]=prefs.MaxSelect,["cancelable"]=prefs.Cancelable,
+            ["require_manual_confirmation"]=prefs.RequireManualConfirmation,["unpowered_previews"]=prefs.UnpoweredPreviews,
+            ["pretend_cards_can_be_played"]=prefs.PretendCardsCanBePlayed,["selection_contract"]=Protocol };
+        if(raw["enchantment"]!=null)surface["enchantment"]=raw["enchantment"]!.DeepClone();
+        var result=new List<NativeUiBoundAction>();
+        if(choices)
+        {
+            if(view.Selected.Count!=0||view.Stage=="preview")throw new InvalidOperationException("Unowned partial atomic selection");
+            var names=cards.ToDictionary(c=>c!["entity_id"]!.GetValue<string>(),c=>c!["name"]?.GetValue<string>()??"Card");
+            foreach(var set in AtomicSelectionDomain.Enumerate(view.Selectable,prefs.MinSelect,prefs.MaxSelect,prefs.Cancelable))
+            {
+                if(set.Any(id=>!view.Selectable.Contains(id)))throw new InvalidOperationException("Selection domain includes an unavailable card");
+                var operands=new Dictionary<string,string>{{"screen_id",owner}};
+                var bindings=new List<ActionEntityBinding>();
+                for(int i=0;i<set.Length;i++){operands[$"selected_{i:D3}_id"]=set[i];bindings.Add(new("selected_card",set[i]));}
+                string operation="atomic_confirm_cards",command="confirm_interaction";
+                string candidate="atomic_"+StableIdentityHash.Object(new{operation,operands});
+                result.Add(new(new NativeUiActionCandidate(candidate,command,operation,
+                    set.Length==0?"Confirm empty selection":"Confirm "+string.Join(", ",set.Select(id=>names[id])),
+                    operands,new Dictionary<string,NativeUiOperandDomain>(),bindings,"player_environment_native_binding")));
+            }
+            if(prefs.Cancelable)
+            {
+                if(!view.CanCancel)throw new InvalidOperationException("Cancelable selector has no current cancel control");
+                var operands=new Dictionary<string,string>{{"screen_id",owner}};
+                result.Add(new(new NativeUiActionCandidate("atomic_cancel_"+StableIdentityHash.Object(operands),"cancel_interaction",
+                    "atomic_cancel_selection","Cancel selection",operands,new Dictionary<string,NativeUiOperandDomain>(),
+                    Array.Empty<ActionEntityBinding>(),"player_environment_native_binding")));
+            }
+        }
+        return new(view,surface,prefs,primitive,result);
+    }
+    internal static NativeInputResult Start(LiveObservation draft,NativeUiBoundAction binding,
+        IReadOnlyDictionary<string,string> parameters,NativeEntityRegistry entities,string request,string snapshot)
+    {
+        if(Active!=null)return NativeInputResult.Rejected("atomic_selection_busy","Never submit a second selection while one is pending.");
+        var root=Read(draft,entities,true)??throw new InvalidOperationException("Current owner is not an atomic selector");
+        var match=root.Choices.SingleOrDefault(b=>b.Candidate.CandidateId==binding.Candidate.CandidateId);
+        if(match==null||!NativeUiActionRuntime.OperandsMatch(match.Candidate,parameters))
+            return NativeInputResult.Rejected("atomic_selection_changed","The exact complete card choice changed.");
+        bool cancel=binding.Candidate.Operation=="atomic_cancel_selection";
+        var chosen=parameters.Where(p=>p.Key.StartsWith("selected_",StringComparison.Ordinal)).OrderBy(p=>p.Key,StringComparer.Ordinal).Select(p=>p.Value).ToArray();
+        bool auto=chosen.Length==root.Preferences.MaxSelect&&!root.Preferences.RequireManualConfirmation&&root.View.Kind is "native_simple_card_selection" or "combat_hand_card_selection" or "native_combat_pile_selection";
+        Active=new(request,snapshot,root.View.Owner,new(root.View,chosen,cancel,auto),DateTime.UtcNow.AddSeconds(12),new(),chosen,cancel,auto,root.Preferences.MaxSelect,(JsonObject)JsonSerializer.SerializeToNode(draft.Surface,draft.Surface.GetType(),ConnectorMod._jsonOptions)!);
+        last=new {status="pending",request_id=request,root_snapshot_id=snapshot,owner_id=root.View.Owner,chosen_card_ids=chosen};
+        return NativeInputResult.Delivered("atomic_selection_accepted_no_retry");
+    }
+    internal static bool Advance(LiveObservation draft,NativeEntityRegistry entities)
+    {
+        if(Active==null)return false;
+        var txn=Active;
+        if(DateTime.UtcNow>txn.Deadline)throw Stop("atomic_selection_timeout");
+        AtomicChoiceRoot? current=IsFamily(draft.Surface.Kind)?Read(draft,entities,false):null;
+        if(current==null && entities.TryResolve(txn.Owner,out Godot.CanvasItem? owner) && owner!=null
+            && ConnectorMod.IsLiveNode(owner) && ConnectorMod.IsNodeVisible(owner))return true;
+        var step=txn.Kernel.Advance(current?.View);
+        if(txn.Kernel.Status=="unknown")throw Stop(txn.Kernel.Error!);
+        if(txn.Kernel.Status is "committed" or "canceled")
+        {
+            last=new{status=txn.Kernel.Status,request_id=txn.Request,root_snapshot_id=txn.Snapshot,owner_id=txn.Owner,
+                chosen_card_ids=txn.Chosen,steps=txn.Steps.ToArray(),game_committed=txn.Kernel.Status=="committed",automatic_commit_allowed=txn.Auto,maximum_selection=txn.Maximum,root_ui_surface=txn.RootUi};
+            Active=null;return false;
+        }
+        if(step==null)return true;
+        if(current==null)throw Stop("atomic_selection_owner_missing");
+        var options=current.Primitives.Where(b=>step.Kind switch {
+            "select"=>b.Candidate.Command=="select_entity"&&b.Candidate.Operands.GetValueOrDefault("card_id")==step.Card,
+            "preview"=>b.Candidate.Command=="confirm_interaction"&&b.Candidate.Operation.Contains("preview",StringComparison.Ordinal),
+            "confirm"=>b.Candidate.Command=="confirm_interaction"&&b.Candidate.Operation.Contains("confirm",StringComparison.Ordinal)&&!b.Candidate.Operation.Contains("preview",StringComparison.Ordinal),
+            "cancel"=>b.Candidate.Command=="cancel_interaction"&&!b.Candidate.Operation.Contains("preview",StringComparison.Ordinal),_=>false }).ToArray();
+        if(options.Length!=1)throw Stop("atomic_selection_control_ambiguous");
+        var action=options[0];var result=PlayerEnvironmentService.StartPrimitiveInput(draft,action,action.Candidate.Operands);
+        txn.Steps.Add(new {kind=step.Kind,card_id=step.Card,candidate_id=action.Candidate.CandidateId,accepted=result.Accepted,evidence=result.DeliveryEvidence});
+        if(!result.Accepted)throw Stop(result.ErrorCode??"atomic_selection_input_rejected");
+        return true;
+    }
+    private static Exception Stop(string error)
+    {
+        if(Active is { } txn)last=new{status="unknown",error,request_id=txn.Request,root_snapshot_id=txn.Snapshot,steps=txn.Steps.ToArray()};
+        // Keep the uncertain transaction blocked. Never reset, rollback or retry it.
+        return new InvalidOperationException(error+"; preserve evidence and do not retry");
+    }
+}
diff --git a/host/NativeUi/AtomicSelectionKernel.cs b/host/NativeUi/AtomicSelectionKernel.cs
new file mode 100644
index 0000000..c92e45b
--- /dev/null
+++ b/host/NativeUi/AtomicSelectionKernel.cs
@@ -0,0 +1,99 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+namespace STS2Connector.NativeUi;
+
+internal sealed record AtomicSelectionView(string Owner, string Kind, string Facts, string Stage,
+    IReadOnlyList<string> Selected, IReadOnlyList<string> Selectable,
+    bool CanPreview, bool CanConfirm, bool CanCancel, bool CanReturn);
+internal sealed record AtomicSelectionStep(string Kind, string? Card = null);
+
+internal static class AtomicSelectionDomain
+{
+    internal const int Limit = 512;
+    // Selection order is explicit. Never collapse differently ordered native
+    // answers or silently truncate a menu which exceeds the wire bound.
+    internal static IReadOnlyList<string[]> Enumerate(IReadOnlyList<string> cards,int min,int max,bool cancelable)
+    {
+        if (cards.Distinct().Count()!=cards.Count || min<0 || max<min || min>cards.Count)
+            throw new InvalidOperationException("Invalid exact selection domain");
+        var result=new List<string[]>();
+        void Visit(List<string> chosen,int count)
+        {
+            if(chosen.Count==count)
+            {
+                result.Add(chosen.ToArray());
+                if(result.Count+(cancelable?1:0)>Limit)throw new InvalidOperationException("atomic_selection_domain_exceeds_bound");
+                return;
+            }
+            foreach(var id in cards)if(!chosen.Contains(id)) {chosen.Add(id);Visit(chosen,count);chosen.RemoveAt(chosen.Count-1);}
+        }
+        for(int n=min;n<=Math.Min(max,cards.Count);n++)Visit(new(),n);
+        return result;
+    }
+}
+
+// Pure transaction state: it requests only the chosen cards and necessary UI
+// controls. The game-backed bridge revalidates and delivers each step once.
+internal sealed class AtomicSelectionKernel
+{
+    private readonly AtomicSelectionView root;
+    private readonly string[] chosen;
+    private readonly bool cancel,mayAutoCommit;
+    private readonly HashSet<string> accepted=new();
+    private AtomicSelectionStep? pending;
+    private bool finalIssued;
+    internal string Status {get;private set;}="pending";
+    internal string? Error {get;private set;}
+    internal int Issued {get;private set;}
+    internal AtomicSelectionKernel(AtomicSelectionView root,IReadOnlyList<string> chosen,bool cancel,bool mayAutoCommit)
+    {
+        if(root.Selected.Count!=0||chosen.Distinct().Count()!=chosen.Count||chosen.Any(c=>!root.Selectable.Contains(c)))
+            throw new InvalidOperationException("Selection root is not an exact fresh choice");
+        this.root=root;this.chosen=chosen.ToArray();this.cancel=cancel;this.mayAutoCommit=mayAutoCommit;
+    }
+    private AtomicSelectionStep? Fail(string why){Status="unknown";Error=why;return null;}
+    internal AtomicSelectionStep? Advance(AtomicSelectionView? current)
+    {
+        if(Status!="pending")return null;
+        if(current==null||current.Owner!=root.Owner)
+        {
+            if(finalIssued||(pending?.Kind=="select"&&mayAutoCommit&&accepted.Count+1==chosen.Length))
+            {Status=cancel?"canceled":"committed";return null;}
+            return Fail("selection_owner_changed_before_commit");
+        }
+        if(finalIssued)return null; // native commit effects may update the still-closing view
+        if(current.Kind!=root.Kind||current.Facts!=root.Facts)return Fail("selection_facts_changed");
+        if(current.Selected.Distinct().Count()!=current.Selected.Count||current.Selected.Any(c=>!chosen.Contains(c)))
+            return Fail("unexpected_selected_cards");
+        if(pending?.Kind=="select")
+        {
+            if(current.Selected.Contains(pending.Card!)){accepted.Add(pending.Card!);pending=null;}
+            else if(current.Selected.Count==accepted.Count)return null; // waiting, never resend
+            else return Fail("selected_prefix_changed");
+        }
+        else if(pending?.Kind=="preview")
+        {
+            if(current.Stage=="preview"||current.CanConfirm){pending=null;}
+            else return null;
+        }
+        else if(pending!=null)return null; // final click: await owner departure
+        if(!current.Selected.ToHashSet().SetEquals(accepted))return Fail("selected_prefix_changed");
+        if(cancel)
+        {
+            if(!current.CanCancel)return null;
+            finalIssued=true;pending=new("cancel");
+        }
+        else if(accepted.Count<chosen.Length)
+        {
+            string card=chosen[accepted.Count];
+            if(!current.Selectable.Contains(card))return Fail("chosen_card_no_longer_selectable");
+            pending=new("select",card);
+        }
+        else if(current.CanConfirm){finalIssued=true;pending=new("confirm");}
+        else if(current.CanPreview)pending=new("preview");
+        else return null;
+        if(++Issued>chosen.Length+3)return Fail("selection_step_cap");
+        return pending;
+    }
+}
