diff --git a/host/tests/STS2Connector.Host.Tests/AtomicSelectionKernelTests.cs b/host/tests/STS2Connector.Host.Tests/AtomicSelectionKernelTests.cs
new file mode 100644
index 0000000..4eece2e
--- /dev/null
+++ b/host/tests/STS2Connector.Host.Tests/AtomicSelectionKernelTests.cs
@@ -0,0 +1,51 @@
+using System;
+using System.Linq;
+using STS2Connector.NativeUi;
+using Xunit;
+namespace STS2Connector;
+public sealed class AtomicSelectionKernelTests
+{
+    private static AtomicSelectionView View(string[]? selected=null,string stage="selecting",bool preview=false,bool confirm=false,bool cancel=false,string owner="owner",string facts="facts")=>
+        new(owner,"deck",facts,stage,selected??Array.Empty<string>(),new[]{"a","b","c"},preview,confirm,cancel,stage=="preview");
+    [Fact] public void AllOrderedChoicesAndEmptyAreRepresentedWithoutDuplicates()
+    {
+        var sets=AtomicSelectionDomain.Enumerate(new[]{"a","b","c"},0,2,true);
+        Assert.Equal(10,sets.Count);Assert.Contains(sets,s=>s.SequenceEqual(new[]{"a","b"}));Assert.Contains(sets,s=>s.SequenceEqual(new[]{"b","a"}));
+        Assert.Contains(sets,s=>s.Length==0);
+    }
+    [Fact] public void OversizedDomainsRejectBeforePublication()=>Assert.Throws<InvalidOperationException>(()=>AtomicSelectionDomain.Enumerate(Enumerable.Range(0,25).Select(i=>i.ToString()).ToArray(),0,2,true));
+    [Fact] public void NoPrimitiveIsRepeatedWhileWaitingForTheGame()
+    {
+        var k=new AtomicSelectionKernel(View(),new[]{"a"},false,false);
+        Assert.Equal("select",k.Advance(View())!.Kind);Assert.Null(k.Advance(View()));Assert.Null(k.Advance(View()));Assert.Equal(1,k.Issued);
+        Assert.Equal("confirm",k.Advance(View(new[]{"a"},"preview",confirm:true))!.Kind);Assert.Null(k.Advance(View(new[]{"a"},"preview",confirm:true)));
+        Assert.Null(k.Advance(null));Assert.Equal("committed",k.Status);Assert.Equal(2,k.Issued);
+    }
+    [Fact] public void MultiCardPlanPreservesChosenOrderAndUsesOnlyRequiredControls()
+    {
+        var k=new AtomicSelectionKernel(View(),new[]{"b","a"},false,false);
+        Assert.Equal("b",k.Advance(View())!.Card);Assert.Equal("a",k.Advance(View(new[]{"b"}))!.Card);
+        Assert.Equal("preview",k.Advance(View(new[]{"a","b"},preview:true))!.Kind);
+        Assert.Null(k.Advance(View(new[]{"a","b"},preview:true)));
+        Assert.Equal("confirm",k.Advance(View(new[]{"a","b"},"preview",confirm:true))!.Kind);
+        Assert.Null(k.Advance(null));Assert.Equal("committed",k.Status);
+    }
+    [Fact] public void EarlyOwnerDepartureIsUncertainAndNeverRetried()
+    {var k=new AtomicSelectionKernel(View(),new[]{"a"},false,false);k.Advance(View());k.Advance(null);Assert.Equal("unknown",k.Status);Assert.Null(k.Advance(View()));Assert.Equal(1,k.Issued);}
+    [Fact] public void OnlyQualifiedAutomaticCommitCanCompleteAfterLastCard()
+    {var k=new AtomicSelectionKernel(View(),new[]{"a"},false,true);k.Advance(View());k.Advance(null);Assert.Equal("committed",k.Status);}
+    [Fact] public void CancelAndConfirmEmptyAreSeparateOperations()
+    {
+        var cancel=new AtomicSelectionKernel(View(cancel:true),Array.Empty<string>(),true,false);
+        Assert.Equal("cancel",cancel.Advance(View(cancel:true))!.Kind);cancel.Advance(null);Assert.Equal("canceled",cancel.Status);
+        var empty=new AtomicSelectionKernel(View(confirm:true),Array.Empty<string>(),false,false);
+        Assert.Equal("confirm",empty.Advance(View(confirm:true))!.Kind);empty.Advance(null);Assert.Equal("committed",empty.Status);
+    }
+    [Fact] public void ChangedOwnerFactsAndUnexpectedSelectionsStopTheTransaction()
+    {
+        var k=new AtomicSelectionKernel(View(),new[]{"a"},false,false);k.Advance(View(facts:"changed"));Assert.Equal("unknown",k.Status);
+        k=new(View(),new[]{"a"},false,false);k.Advance(View(new[]{"b"}));Assert.Equal("unknown",k.Status);
+    }
+    [Fact] public void DuplicateAndForeignCardsRejectAtTheRoot()
+    {Assert.Throws<InvalidOperationException>(()=>new AtomicSelectionKernel(View(),new[]{"a","a"},false,false));Assert.Throws<InvalidOperationException>(()=>new AtomicSelectionKernel(View(),new[]{"foreign"},false,false));}
+}
