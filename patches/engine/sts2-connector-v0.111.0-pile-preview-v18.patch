diff --git a/host/NativeUi/NativeNonCombatPotions.cs b/host/NativeUi/NativeNonCombatPotions.cs
new file mode 100644
index 0000000..25c065b
--- /dev/null
+++ b/host/NativeUi/NativeNonCombatPotions.cs
@@ -0,0 +1,149 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text.Json.Nodes;
+using MegaCrit.Sts2.Core.Combat;
+using MegaCrit.Sts2.Core.Context;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Entities.Actions;
+using MegaCrit.Sts2.Core.Entities.Potions;
+using MegaCrit.Sts2.Core.GameActions;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Models.Potions;
+using MegaCrit.Sts2.Core.Nodes;
+using MegaCrit.Sts2.Core.Runs;
+using STS2Connector.LiveHost;
+using STS2Connector.LiveHost.Contracts;
+
+namespace STS2Connector.NativeUi;
+
+// The normal global potion HUD remains actionable outside combat. Its controls
+// use the same current owner/slot/permission predicates again at execution.
+internal static class NativeNonCombatPotions
+{
+    internal sealed record Projection(JsonArray Rows, IReadOnlyList<NativeUiBoundAction> Bindings,
+        JsonObject? PlayerTarget, JsonObject? MerchantTarget);
+
+    private static readonly Dictionary<PotionModel,DiscardPotionGameAction> PendingDiscards = new();
+    internal static bool HasPendingDiscard
+    {
+        get
+        {
+            foreach (var item in PendingDiscards.ToArray())
+                if (item.Value.State is GameActionState.Finished or GameActionState.Canceled
+                    || !item.Key.Owner.PotionSlots.Contains(item.Key)) PendingDiscards.Remove(item.Key);
+            return PendingDiscards.Count > 0;
+        }
+    }
+    private static bool Eligible(LiveObservation draft, out Player? player)
+    {
+        player = null;
+        if (draft.Readiness != "ready" || draft.Surface.Kind is not
+            ("event_option" or "event_dialogue" or "map_navigation" or "rest_site" or "shop_room"
+             or "shop_inventory" or "treasure_room" or "reward_claim" or "card_reward_selection"
+             or "card_bundle_selection" or "deck_transform_selection" or "deck_enchant_selection"
+             or "native_deck_card_selection" or "native_simple_card_selection"
+             or "native_deck_upgrade_selection" or "native_generated_card_choice")
+            || NRun.Instance == null || !RunManager.Instance.IsInProgress || RunManager.Instance.IsGameOver
+            || CombatManager.Instance.IsInProgress || HasPendingDiscard)
+            return false;
+        var run = RunManager.Instance.DebugOnlyGetState();
+        if (run == null || run.Players.Count != 1) return false;
+        player = LocalContext.GetMe(run);
+        return player != null && player.Creature.IsAlive;
+    }
+
+    internal static bool DiscardPermission(bool alive, bool permission, bool owned, bool queued) =>
+        alive && permission && owned && !queued;
+
+    internal static bool UsePermission(bool discardAllowed, PotionUsage usage, bool removed, bool custom) =>
+        discardAllowed && usage == PotionUsage.AnyTime && !removed && custom;
+
+    internal static Projection Build(LiveObservation draft, NativeEntityRegistry entities)
+    {
+        var rows = new JsonArray(); var bindings = new List<NativeUiBoundAction>();
+        JsonObject? playerTarget = null, merchantTarget = null;
+        if (!Eligible(draft, out var owner)) return new(rows, bindings, null, null);
+        Player player = owner!;
+        string roomId = entities.GetId(player.RunState.CurrentRoom!, "room");
+        for (int slot = 0; slot < player.PotionSlots.Count; slot++)
+        {
+            PotionModel? potion = player.GetPotionAtSlotIndex(slot);
+            if (potion == null) continue;
+            bool discard = DiscardPermission(player.Creature.IsAlive, player.CanUseOrRemovePotions,
+                ReferenceEquals(potion.Owner, player), potion.IsQueued);
+            bool use = UsePermission(discard, potion.Usage, potion.HasBeenRemovedFromState,
+                potion.PassesCustomUsabilityCheck);
+            string id = entities.GetId(potion, "potion"), name = ConnectorMod.SafeGetText(() => potion.Title) ?? potion.Id.Entry;
+            string? targetId = null;
+            if (use && potion.TargetType == TargetType.AnyPlayer)
+            {
+                use = potion.IsValidTarget(player.Creature);
+                if (use)
+                {
+                    targetId = entities.GetId(player.Creature, "player");
+                    playerTarget = new JsonObject { ["entity_id"] = targetId, ["hp"] = player.Creature.CurrentHp,
+                        ["max_hp"] = player.Creature.MaxHp };
+                }
+            }
+            else if (use && potion.TargetType == TargetType.TargetedNoCreature)
+            {
+                var target = FoulPotion.GetFoulPotionMerchantTarget(player.RunState.CurrentRoom!);
+                use = potion is FoulPotion && target.button != null;
+                if (use)
+                {
+                    targetId = entities.GetId(target.button!, "merchant");
+                    merchantTarget = new JsonObject { ["entity_id"] = targetId, ["target_type"] = "merchant", ["inventory_open"] = false };
+                }
+            }
+            else if (use && potion.TargetType is not (TargetType.Self or TargetType.None))
+                throw new NotSupportedException("Unmapped current noncombat potion target: " + potion.TargetType);
+            var targets = new JsonArray(); if (targetId != null) targets.Add(targetId);
+            rows.Add(new JsonObject { ["entity_id"] = id, ["definition_id"] = potion.Id.Entry, ["name"] = name,
+                ["description"] = ConnectorMod.SafeGetText(() => potion.DynamicDescription), ["slot"] = slot,
+                ["usage"] = potion.Usage.ToString(), ["target_type"] = potion.TargetType.ToString(),
+                ["can_use"] = use, ["can_discard"] = discard, ["target_entity_ids"] = targets });
+            void Add(string command, string operation, string label)
+            {
+                var operands = new Dictionary<string,string> { ["potion_id"] = id,
+                    ["potion_slot"] = slot.ToString(System.Globalization.CultureInfo.InvariantCulture), ["room_id"] = roomId };
+                var entitiesForAction = new List<ActionEntityBinding> { new("potion",id) };
+                if (operation == "belt_use" && targetId != null)
+                { operands["target_id"] = targetId; entitiesForAction.Add(new("target",targetId)); }
+                string candidateId = "belt_" + StableIdentityHash.Object(new { command, operation, operands });
+                bindings.Add(new(new NativeUiActionCandidate(candidateId,command,operation,label,operands,
+                    new Dictionary<string,NativeUiOperandDomain>(),entitiesForAction,"player_environment_native_binding")));
+            }
+            if (use) Add("use_potion","belt_use",targetId == null ? $"Use {name}" :
+                $"Use {name} on {(potion.TargetType == TargetType.TargetedNoCreature ? "Merchant" : ConnectorMod.SafeGetText(() => player.Character.Title))}");
+            if (discard) Add("activate_control","belt_discard",$"Discard {name}");
+        }
+        return new(rows,bindings,playerTarget,merchantTarget);
+    }
+
+    internal static NativeInputResult Start(LiveObservation draft, NativeUiInput request,
+        NativeUiBoundAction binding, NativeEntityRegistry entities)
+    {
+        var projection = Build(draft, entities);
+        var current = projection.Bindings.SingleOrDefault(b => b.Candidate.CandidateId == binding.Candidate.CandidateId);
+        if (current == null || request.Command != current.Candidate.Command
+            || request.Operands == null || !NativeUiActionRuntime.OperandsMatch(current.Candidate,request.Operands)
+            || !Eligible(draft,out var player)
+            || !entities.TryResolve(current.Candidate.Operands["potion_id"],out PotionModel? potion) || potion == null)
+            return NativeInputResult.Rejected("belt_binding_changed","The current potion owner, slot, target or permission changed.");
+        int slot = int.Parse(current.Candidate.Operands["potion_slot"],System.Globalization.CultureInfo.InvariantCulture);
+        if (!ReferenceEquals(player!.GetPotionAtSlotIndex(slot),potion))
+            return NativeInputResult.Rejected("belt_slot_changed","The advertised potion is no longer in that slot.");
+        if (current.Candidate.Operation == "belt_discard")
+        {
+            var action = new DiscardPotionGameAction(player,(uint)slot,false);
+            RunManager.Instance.ActionQueueSynchronizer.RequestEnqueue(action);
+            PendingDiscards.Add(potion,action);
+            return NativeInputResult.Delivered("native_noncombat_potion_discard_enqueued");
+        }
+        var target = potion.TargetType is TargetType.AnyPlayer or TargetType.Self ? player.Creature : null;
+        potion.EnqueueManualUse(target);
+        return NativeInputResult.Delivered("native_noncombat_potion_use_enqueued");
+    }
+}
