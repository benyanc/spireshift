+    private static void HandlePostSelectionProvenance(HttpListenerRequest request,HttpListenerResponse response)
+    {
+        var body=ReadBoundedJsonBody<HostShutdownRequest>(request,response,MaxHostControlBodyBytes,"Selection provenance");
+        if(body==null)return;
+        if(!IsSafeProtocolIdentifier(body.ExpectedRuntimeInstanceId,128)||body.HostControlToken?.Length!=64)
+        {SendApiError(response,400,"invalid_selection_provenance","Exact runtime and process-local token required.");return;}
+        try
+        {
+            var auth=HostLifecycleControl.Authorize(body);
+            if(!auth.Allowed){SendApiError(response,403,auth.Status,"Selection provenance read rejected.");return;}
+            var task=RunOnMainThread(()=>new {runtime_instance_id=auth.RuntimeInstanceId,selection=STS2Connector.NativeUi.AtomicCardSelection.Provenance()});
+            SendJson(response,task.GetAwaiter().GetResult());
+        }
+        catch(Exception exception){SendApiInternalError(response,"selection_provenance_failed",exception);}
+    }
+
 }
