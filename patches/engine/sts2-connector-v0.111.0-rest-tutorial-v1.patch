+    private static LiveObservation BuildRestSite(
+        NRestSiteFtue modal, NativeEntityRegistry entities, GameBuildIdentity game)
+    {
+        ILiveContext context = LiveContextReader.Build(entities);
+        try
+        {
+            NButton button = modal.GetNode<NButton>("FtuePopup/FtueConfirmButton");
+            string? title = ReadLabel(modal.GetNode<MegaLabel>("FtuePopup/Header"));
+            string? body = ReadRichText(modal.GetNode<MegaRichTextLabel>(
+                "FtuePopup/DescriptionContainer/Description"));
+            string? label = ReadLabel(button.GetNode<MegaLabel>("%Label"));
+            if (title == null || body == null || label == null)
+                return BindingUnavailable(game, context, nameof(NRestSiteFtue),
+                    "Rest tutorial text or confirmation label is unavailable.");
+            bool enabled = IsUsable(button);
+            var surface = new TutorialSurface(SurfaceKind, "confirmation",
+                entities.GetId(modal, "screen"), RestSiteId, null, null, title, body, null,
+                enabled ? new[] { new VisibleTutorialOption("dismiss_tutorial", label, true) }
+                    : Array.Empty<VisibleTutorialOption>());
+            return ReadyObservation(game, context, surface, enabled,
+                "NRestSiteFtue exact current modal and visible FtueConfirmButton");
+        }
+        catch (Exception ex)
+        {
+            return BindingUnavailable(game, context, nameof(NRestSiteFtue),
+                $"Rest tutorial binding failed: {ex.GetType().Name}.");
+        }
+    }
+
+    internal static NativeInputResult StartRestSite(
+        NativeEntityRegistry entities, string expectedScreenId)
+    {
+        if (!TryResolveCurrentModal(entities, expectedScreenId, out NRestSiteFtue? modal)
+            || modal == null)
+            return NativeInputResult.Rejected("rest_tutorial_owner_changed",
+                "The exact rest tutorial modal is no longer current.");
+        try
+        {
+            NButton button = modal.GetNode<NButton>("FtuePopup/FtueConfirmButton");
+            if (!IsUsable(button))
+                return NativeInputResult.Rejected("rest_tutorial_control_changed",
+                    "The rest tutorial confirmation is no longer visible and enabled.");
+            button.ForceClick();
+            return NativeInputResult.Delivered(RestDeliveryEvidence);
+        }
+        catch (Exception ex)
+        {
+            return NativeInputResult.Rejected("rest_tutorial_binding_failed",
+                $"The exact rest tutorial control could not be resolved: {ex.GetType().Name}.");
+        }
+    }
