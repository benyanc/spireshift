+    [Fact]
+    public void RestTutorialDismissalIsRestrictedToItsExactEnabledModal()
+    {
+        var surface = new TutorialSurface("tutorial", "confirmation", "rest-popup",
+            TutorialModalSurfaceReader.RestSiteId, null, null, "Rest", "Rest information", null,
+            new[] { new VisibleTutorialOption("dismiss_tutorial", "Continue", true) });
+        NativeUiActionDescriptor command = Assert.Single(NativeUiActionRuntime.DescribeTutorialCommands(surface));
+        Assert.Equal("dismiss_tutorial", command.Kind);
+        Assert.Contains(command.EntityBindings!, row => row.Role == "screen" && row.EntityId == "rest-popup");
+        Assert.Empty(NativeUiActionRuntime.DescribeTutorialCommands(surface with { TutorialId = "unknown_ftue" }));
